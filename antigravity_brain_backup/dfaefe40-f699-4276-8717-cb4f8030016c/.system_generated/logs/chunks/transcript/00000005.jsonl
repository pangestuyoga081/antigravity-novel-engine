ame);\\n      if (ent.isDirectory()) {\\n        scanDir(full);\\n      } else if (/\\\\.(html|xhtml)$/i.test(ent.name)) {\\n        if (/cover|toc|bookmark|titlepage|copyright/i.test(ent.name)) continue;\\n        \\n        const html = fs.readFileSync(full, 'utf-8');\\n        let cleanText = html\\n          .replace(/<script\\\\b[^<]*(?:(?\n<truncated 11633 bytes>","Overwrite":"true","Path":"\"D:\\\\JV\\\\novel yoga\\\\translate-novel-dragndrop.ts\""}}],"truncated_fields":["tool_calls"]}
