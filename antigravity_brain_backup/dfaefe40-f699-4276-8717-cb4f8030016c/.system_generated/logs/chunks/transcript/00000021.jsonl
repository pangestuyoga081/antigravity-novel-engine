termarks(text);\n905:   if (sanitize || styleMode === 'konosuba' || styleMode === 'overlord') {\n906:     processedText = sanitizeSensitiveWords(processedText);\n907:     processedText = maskCopyrightTokens(processedText);\n908:   }\n909: \n910:   const promptContent = buildPrompt(processedText, styleMode, simplified);","truncated_fields":["content"]}
