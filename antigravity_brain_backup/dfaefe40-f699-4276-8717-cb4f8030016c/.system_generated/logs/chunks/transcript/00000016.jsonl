\n388:     total_time = time.time() - t0\n389:     print(\"\\n==================================================================\")\n390:     print(f\"🎉 SEMUA 24 VOLUME EPUB SUKSES DIBUAT DALAM {total_time:.1f} DETIK!\")\n391:     print(f\"📁 Folder Output: {EPUB_OUT_DIR}\")\n392:     print(\"==================================================================\")\n393: \n394: if __name__ == \"__main__\":\n395:     main()","truncated_fields":["content"]}
