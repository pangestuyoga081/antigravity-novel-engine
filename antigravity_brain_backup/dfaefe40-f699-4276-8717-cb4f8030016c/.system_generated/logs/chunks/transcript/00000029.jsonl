me, duration: Date.now() - start, content });\\n        } catch (e) {\\n          resolve({ model: modelName, error: data });\\n        }\\n      });\\n    });\\n    req.on('error', e => resolve({ model: modelName, error: e.message }));\\n    req.write(payload);\\n    req.end();\\n  });\\n}\\n\\nasync function main() {\\n  console.log('Testin\n<truncated 304 bytes>","Path":"\"D:/JV/novel yoga/test_v3_vs_v4.js\""}}],"truncated_fields":["tool_calls"]}
