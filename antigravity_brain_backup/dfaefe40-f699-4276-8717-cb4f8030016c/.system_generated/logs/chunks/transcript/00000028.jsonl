 (isChapHeader && !isFalsePositive) {\n661:         if (curChap && curLines.length > 0) {\n662:           curChap.text = curLines.join('\\n').trim();\n663:           if (curChap.text.length > 50) chapters.push(curChap);\n664\n<truncated 1015 bytes>\n   }\n682: \n683:         curChap = {\n684:           id: chId,\n685:           title: fullTitle,\n686:           text: ''\n687:         };\n688:         curLines = [];\n689:         continue;\n690:       }\n691: \n692:       if (curChap) {\n693:         if (/^\\s*Mushoku\\s*Tensei\\s*[–—\\-]\\s*Volume\\s*\\d+\\s*$/i.test(l)) continue;\n694:         curLines.push(rawLine);\n695:       }\n696:     }\n697: \n698:     if (curChap && curLines.length > 0) {\n699:       curChap.text = curLines.join('\\n').trim();\n700:       if (curChap.text.length > 50) chapters.push(curChap);\n701:     }\n702: \n703:     return chapters;\n704:   }\n705: \n706:   // Generic fallback TXT parser\n707:   const chapters: Chapter[] = [];\n708:   let currentChap: Chapter | null = null;\n709:   let currentLines: string[] = [];\n710:   let chIndex = 1;\n711: \n712:   for (let i = 0; i < lines.length; i++) {\n713:     const rawLine = lines[i];\n714:     const line = rawLine.trim();\n715: \n716:     if (/^(CHAPTER|BAB)\\s+[0-9]+/i.test(line) && currentLines.length > 200) {\n717:       if (currentChap) {\n718:         currentChap.text = cleanWatermarks(currentLines.join('\\n').trim());\n719:         chapters.push(currentChap);\n720:       }\n721:       currentChap = {\n722:         id: `chap_${String(chIndex++).padStart(2, '0')}`,\n723:         title: line,\n724:         text: ''\n725:       };\n726:       currentLines = [];\n727:       continue;\n728:     }\n729: \n730:     if (!currentChap && /^(CHAPTER|BAB)\\s+[0-9]+/i.test(line)) {\n731:       currentChap = {\n732:         id: `chap_${String(chIndex++).padStart(2, '0')}`,\n733:         title: line,\n734:         text: ''\n735:       };\n736:       continue;\n737:     }\n738: \n739:     currentLines.push(rawLine);\n740:   }\n741: \n742:   if (currentChap && currentLines.length > 0) {\n743:     currentChap.text = cleanWatermarks(currentLines.join('\\n').trim());\n744:     chapters.push(currentChap);\n745:   }\n746: \n747:   if (chapters.length === 0) {\n748:     return [{ id: 'full_text', title: path.basename(txtPath), text: cleanWatermarks(content) }];\n749:   }\n750: ","truncated_fields":["content"]}
