'🎉 PROSES TERJEMAHAN SELESAI!');\n749:   console.log(`📁 File hasil tersimpan di: ${outputFile}`);\n750:   console.log('================================================================');\n751: }\n752: \n753: main().catch(err => {\n754:   console.error('\\n❌ Terjadi kesalahan fatal:', err);\n755:   process.exit(1);\n756: });","truncated_fields":["content"]}
