{"step_index":186,"source":"MODEL","type":"PLANNER_RESPONSE","status":"DONE","created_at":"2026-11-11T08:22:47Z","input_tokens":2086,"cache_read_tokens":139879,"output_tokens":4436,"tool_calls":[{"name":"write_file","args":{"Content":"#!/usr/bin/env node\n/**\n * ============================================================================\n * 📱 TERMUX LIGHT NOVEL TRANSLATOR - STANDALONE EDITION\n * ============================================================================\n * Script mandiri tanpa dependensi tambahan (100% Native Node.js ESM).\n * Fitur:\n * - Menu Setup Interaktif (API Key, Base URL, Model, Concurrency, Chunk Size).\n * - File konfigurasi otomatis tersimpan di 'config.json'.\n * - Anti-Skip Context Window (Membawa konteks adegan sebelumnya agar cerita nyambung).\n * - Pemotongan Cerita Berbasis Paragraf (Tidak terpotong di tengah kalimat/dialog).\n * - Multi-Worker Parallel Queue dengan susunan narasi terjamin urut.\n * - Robust Checkpoint (`checkpoint.json`) auto-resume jika terputus/baterai habis.\n * - Pembatas rapi tiap Volume & Bab di file output gabungan.\n * ============================================================================\n */\n\nimport fs from 'node:fs';\nimport readline from 'node:readline';\nimport path from 'node:path';\n\nconst CONFIG_FILE = 'config.json';\nconst CHECKPOINT_FILE = 'checkpoint.json';\n\nconst DEFAULT_CONFIG = {\n  apiUrl: 'https://generativelanguage.googleapis.com/v1beta/openai/chat/completions',\n  apiKey: '',\n  model: 'gemini-1.5-flash',\n  inputFile: 'source.txt',\n  outputFile: 'Rokudenashi_ID_Gaul_Full.txt',\n  maxChunkChars: 12000,\n  concurrency: 4\n};\n\nconst SYSTEM_PROMPT = `Kamu adalah penerjemah + asisten pembaca Light Novel profesional ke Bahasa Indonesia.\n\nTUGAS UTAMA (PRIORITAS TERTINGGI):\n1. Terjemahkan CONTENT ke bahasa Indonesia yang santai sehari-hari, gaul, konyol, lucu, dan vulgar (sesuai karakter dan situasi). Bahasa harus hidup, alami, dan menghibur.\n2. Dialog boleh pakai \"gue/lu\" atau umpatan/kata-kata kasar santai sehari-hari jika sesuai dengan emosi dan kepribadian karakter (contoh: Glenn Radars yang mageran, sinis, dan blak-blakan).\n3. Karakter formal, bangsawan, guru, atau tokoh tua tetap dijaga kesopanannya sesuai peran (contoh: Rumia Tingel yang santun, Celica Arfonia yang anggun/mengintimidasi, atau Sistine Fibel yang tsundere).\n4. FORMAT DIALOG: Selalu sertakan NAMA SPEAKER pada dialog secara konsisten dengan format:\n   Nama: \"Isi dialog...\"\n   (Contoh: Glenn Radars: \"Hah?! Sialan, mager banget gila...\", Sistine Fibel: \"Dasar guru mesum nggak guna!\").\n5. JANGAN mengubah alur, kejadian, dialog, atau informasi penting. Hanya gaya bahasa dan suasana yang dibuat santai, kocak, dan menarik.\n6. Source adalah raja. Jangan menambah atau mengurangi isi cerita.\n7. Jangan spoiler dari chapter/scene berikutnya.\n\nGAYA BAHASA:\n- Santai sehari-hari, gaul, konyol, lucu, dan kocak.\n- Boleh kasar, vulgar, dan santai selama sesuai karakter dan situasi.\n- Kalimat pendek, padat, dan tidak kaku (tanpa kalimat puitis/berbunga-bunga klise).\n- Karakterisasi tokoh tetap dijaga ketat.\n- Bikin pembaca ketawa dan enjoy membaca cerita.\n\nNOTES / KOMENTAR (PENJELASAN ISTILAH & FUN FACT):\n- Tambahkan komentar penjelasan istilah atau fun fact singkat dalam tanda kurung siku [Catatan: ...] atau (fun fact: ...) yang RELEVAN dengan istilah asing, sihir, atau budaya yang membingungkan pembaca awam.\n- Fun fact singkat, kontekstual, dan jangan menciptakan lore palsu/spoiler.\n\nOutput HANYA teks hasil terjemahan yang rapi tanpa kata pengantar atau penutup.`;\n\nfunction askQuestion(query) {\n  const rl = readline.createInterface({\n    input: process.stdin,\n    output: process.stdout\n  });\n  return new Promise(resolve => rl.question(query, ans => {\n    rl.close();\n    resolve(ans.trim());\n  }));\n}\n\nfunction loadConfig() {\n  if (fs.existsSync(CONFIG_FILE)) {\n    try {\n      return { ...DEFAULT_CONFIG, ...JSON.parse(fs.readFileSync(CONFIG_FILE, 'utf-8')) };\n    } catch {\n      // ignore\n    }\n  }\n  return { ...DEFAULT_CONFIG };\n}\n\nfunction saveConfig(cfg) {\n  fs.writeFileSync(CONFIG_FILE, JSON.stringify(cfg, null, 2), 'utf-8');\n}\n\nfunction loadCheckpoint() {\n  if (fs.existsSync(CHECKPOINT_FILE)) {\n    try {\n      return JSON.parse(fs.readFileSync(CHECKPOINT_FILE, 'utf-8'));\n    } catch {\n      // ignore\n    }\n  }\n  return { lastCompletedId: null, completedIds: [], totalChapters: 0, lastUpdated: new Date().toISOString() };\n}\n\nfunction saveCheckpoint(cp) {\n  cp.lastUpdated = new Date().toISOString();\n  fs.writeFileSync(CHECKPOINT_FILE, JSON.stringify(cp, null, 2), 'utf-8');\n}\n\nasync function runInteractiveSetup(cfg) {\n  console.log('\\n======================================================');\n  console.log('⚙️  PENGATURAN SETUP TERMUX TRANSLATOR');\n  console.log('======================================================');\n  console.log('Tekan ENTER jika ingin menggunakan nilai default / nilai yang sudah ada.\\n');\n\n  const url = await askQuestion(`1. API URL Endpoint [${cfg.apiUrl}]: `);\n  if (url) cfg.apiUrl = url;\n\n  const key = await askQuestion(`2. API Key [${cfg.apiKey ? cfg.apiKey.substring(0, 8) + '...' : 'Belum diisi'}]: `);\n  if (key) cfg.apiKey = key;\n\n  const model = await askQuestion(`3. Model ID [${cfg.model}]: `);\n  if (model) cfg.model = model;\n\n  const input = await askQuestion(`4. File Sumber (.txt) [${cfg.inputFile}]: `);\n  if (input) cfg.inputFile = input;\n\n  const output = await askQuestion(`5. File Hasil Gabungan (.txt) [${cfg.outputFile}]: `);\n  if (output) cfg.outputFile = output;\n\n  const concurrency = await askQuestion(`6. Jumlah Worker Paralel (1-10) [${cfg.concurrency}]: `);\n  if (concurrency) cfg.concurrency = parseInt(concurrency, 10) || 4;\n\n  const chunkSize = await askQuestion(`7. Maks Karakter per Chunk (5000-20000) [${cfg.maxChunkChars}]: `);\n  if (chunkSize) cfg.maxChunkChars = parseInt(chunkSize, 10) || 12000;\n\n  saveConfig(cfg);\n  console.log('\\n✅ Pengaturan berhasil disimpan ke config.json!');\n}\n\nasync function parseAllVolumesAndChapters(filePath) {\n  if (!fs.existsSync(filePath)) {\n    throw new Error(`File sumber tidak ditemukan di: ${path.resolve(filePath)}`);\n  }\n\n  const fileStream = fs.createReadStream(filePath, { encoding: 'utf-8' });\n  const rl = readline.createInterface({ input: fileStream, crlfDelay: Infinity });\n\n  const chapters = [];\n  let currentVol = 1;\n  let currentChapter = null;\n  let inTocOrDisclaimer = true;\n\n  for await (const rawLine of rl) {\n    const line = rawLine.trim();\n\n    // Deteksi Volume\n    const volMatch = rawLine.match(/^ROKUDENASHI MAJUTSU KOUSHI TO AKASHIC RECORDS - VOLUME (\\d+)/i);\n    if (volMatch) {\n      currentVol = parseInt(volMatch[1], 10);\n      inTocOrDisclaimer = true;\n      continue;\n    }\n\n    // Bersihkan sampah watermark\n    if (!line) continue;\n    if (/^ruidrive\\.com$/i.test(line)) continue;\n    if (/^Volume \\d+$/i.test(line)) continue;\n    if (/^QWER - image\\d+\\./i.test(line)) continue;\n    if (/^PDF by:/i.test(line)) continue;\n\n    // Deteksi Bab / Prolog / Epilog\n    const isHeading = /^(Prolog|Prologue|Epilog|Epilogue|Bab \\d+|Chapter \\d+|Kata Penutup|Afterword)/i.test(line);\n\n    if (isHeading) {\n      if (rawLine.includes('') || line.length < 3) continue;\n\n      inTocOrDisclaimer = false;\n\n      if (currentChapter && currentChapter.lines.length > 0) {\n        chapters.push(currentChapter);\n      }\n\n      const chapterIndex = chapters.filter(c => c.volNum === currentVol).length + 1;\n      const chId = `vol${String(currentVol).padStart(2, '0')}_ch${String(chapterIndex).padStart(2, '0')}`;\n\n      currentChapter = {\n        id: chId,\n        volNum: currentVol,\n        title: line,\n        lines: []\n      };\n      continue;\n    }\n\n    if (inTocOrDisclaimer) continue;\n\n    if (currentChapter) {\n      currentChapter.lines.push(line);\n    }\n  }\n\n  if (currentChapter && currentChapter.lines.length > 0) {\n    chapters.push(currentChapter);\n  }\n\n  return chapters;\n}\n\n// Potong per paragraf/adegan dengan membawa tail overlap (konteks adegan sebelumnya)\nfunction splitIntoParagraphSafeChunks(lines, maxChars) {\n  const chunks = [];\n  let currentLines = [];\n  let currentLength = 0;\n\n  for (let i = 0; i < lines.length; i++) {\n    const line = lines[i];\n    currentLines.push(line);\n    currentLength += line.length + 1;\n\n    // Potong jika melebihi ukuran target dan berada pada akhir kalimat atau jeda dialog\n    const isGoodBreakPoint = /[.!?…”\"]$/.test(line) || line === '';\n\n    if (currentLength >= maxChars && isGoodBreakPoint) {\n      chunks.push(currentLines.join('\\n'));\n      currentLines = [];\n      currentLength = 0;\n    }\n  }\n\n  if (currentLines.length > 0) {\n    chunks.push(currentLines.join('\\n'));\n  }\n\n  return chunks;\n}\n\n// Memanggil API LLM dengan proteksi retry otomatis\nasync function callLLM(promptText, previousContext, cfg, retryCount = 3) {\n  let userContent = '';\n  if (previousContext) {\n    userContent = `[KONTEKS KEJADIAN DARI CHUNK SEBELUMNYA (JANGAN DITERJEMAHKAN ULANG, HANYA ACUAN HUBUNGAN CERITA)]:\n\"...${previousContext.slice(-350)}...\"\n\n[LANJUTAN CERITA YANG HARUS DITERJEMAHKAN]:\n${promptText}`;\n  } else {\n    userContent = `[MULAI BAB/ADEGAN]:\n${promptText}`;\n  }\n\n  const payload = JSON.stringify({\n    model: cfg.model,\n    messages: [\n      { role: 'system', content: SYSTEM_PROMPT },\n      { role: 'user', content: userContent }\n    ],\n    temperature: 0.7,\n    stream: false\n  });\n\n  for (let attempt = 1; attempt <= retryCount; attempt++) {\n    try {\n      const response = await fetch(cfg.apiUrl, {\n        method: 'POST',\n        headers: {\n          'Content-Type': 'application/json',\n          'Authorization': `Bearer ${cfg.apiKey}`\n        },\n        body: payload\n      });\n\n      if (!response.ok) {\n        const errorText = await response.text();\n        throw new Error(`HTTP ${response.status}: ${errorText}`);\n      }\n\n      const json = await response.json();\n      const content = json.choices?.[0]?.message?.content;\n      if (!content || !content.trim()) {\n        throw new Error('LLM mengembalikan output kosong');\n      }\n\n      return content.trim();\n    } catch (err) {\n      console.warn(`\\n⚠️  [Percobaan ${attempt}/${retryCount}] Gagal: ${err.message}`);\n      if (attempt === retryCount) throw err;\n      await new Promise(r => setTimeout(r, 2000 * attempt));\n    }\n  }\n\n  throw new Error('Gagal menghubungi API setelah beberapa kali percobaan.');\n}\n\n// Concurrency runner yang menjaga indeks urutan tetap presisi\nasync function mapConcurrent(items, limit, fn) {\n  const results = new Array(items.length);\n  let nextIdx = 0;\n\n  async function worker() {\n    while (nextIdx < items.length) {\n      const current = nextIdx++;\n      results[current] = await fn(items[current], current);\n    }\n  }\n\n  const workers = Array.from({ length: Math.min(limit, items.length) }, () => worker());\n  await Promise.all(workers);\n  return results;\n}\n\nasync function startTranslation(cfg) {\n  console.log('\\n======================================================');\n  console.log('🚀 MEMULAI PROSES TRANSLASI BATCH (TERMUX ENGINE)');\n  console.log('======================================================');\n  console.log(`📁 Input  : ${cfg.inputFile}`);\n  console.log(`📄 Output : ${cfg.outputFile}`);\n  console.log(`🤖 Model  : ${cfg.model} via ${new URL(cfg.apiUrl).hostname}`);\n  console.log(`⚡ Worker : ${cfg.concurrency} worker paralel`);\n  console.log('======================================================\\n');\n\n  console.log('🔍 Membaca dan memetakan struktur bab...');\n  const chapters = await parseAllVolumesAndChapters(cfg.inputFile);\n  console.log(`✅ Terdeteksi ${chapters.length} Bab dari seluruh Volume.\\n`);\n\n  const checkpoint = loadCheckpoint();\n  checkpoint.totalChapters = chapters.length;\n\n  let lastVol = 0;\n\n  for (let i = 0; i < chapters.length; i++) {\n    const ch = chapters[i];\n\n    if (checkpoint.completedIds.includes(ch.id)) {\n      console.log(`⏭️  [${i + 1}/${chapters.length}] Lewati ${ch.id} (${ch.title}) - Sudah selesai.`);\n      lastVol = ch.volNum;\n      continue;\n    }\n\n    console.log(`\\n------------------------------------------------------`);\n    console.log(`📖 [${i + 1}/${chapters.length}] Memproses: Volume ${ch.volNum} - ${ch.title} (${ch.lines.length} baris)`);\n    console.log(`------------------------------------------------------`);\n\n    let volumeHeader = '';\n    if (ch.volNum !== lastVol) {\n      volumeHeader = `\\n\\n${'='.repeat(80)}\\nROKUDENASHI MAJUTSU KOUSHI TO AKASHIC RECORDS - VOLUME ${String(ch.volNum).padStart(2, '0')}\\n${'='.repeat(80)}\\n\\n`;\n      lastVol = ch.volNum;\n    }\n\n    const chunks = splitIntoParagraphSafeChunks(ch.lines, cfg.maxChunkChars);\n    console.log(`📦 Dibagi menjadi ${chunks.length} bagian adegan.`);\n\n    const startTime = Date.now();\n    const translatedChunks = await mapConcurrent(chunks, cfg.concurrency, async (chunkText, idx) => {\n      const prevContext = idx > 0 ? chunks[idx - 1] : null;\n      const cStart = Date.now();\n      const res = await callLLM(chunkText, prevContext, cfg);\n      const cDuration = ((Date.now() - cStart) / 1000).toFixed(1);\n      console.log(`   ⚡ Bagian [${idx + 1}/${chunks.length}] selesai (${cDuration}s)`);\n      return res;\n    });\n\n    const totalDuration = ((Date.now() - startTime) / 1000).toFixed(1);\n    console.log(`✅ Bab selesai dalam ${totalDuration}s`);\n\n    const translatedChapterText = translatedChunks.join('\\n\\n');\n    const chapterOutput = `${volumeHeader}### [VOLUME ${String(ch.volNum).padStart(2, '0')}] ${ch.title}\\n\\n${translatedChapterText}\\n\\n`;\n\n    fs.appendFileSync(cfg.outputFile, chapterOutput, 'utf-8');\n\n    checkpoint.lastCompletedId = ch.id;\n    checkpoint.completedIds.push(ch.id);\n    saveCheckpoint(checkpoint);\n\n    console.log(`💾 Bab ${ch.id} berhasil disimpan ke ${cfg.outputFile}`);\n  }\n\n  console.log('\\n======================================================');\n  console.log('🎉 SELURUH VOLUME (VOL 01 - 24) TELAH SELESAI!');\n  console.log(`📁 File hasil akhir: ${cfg.outputFile}`);\n  console.log('======================================================\\n');\n}\n\nasync function main() {\n  const cfg = loadConfig();\n\n  // Cek argumen command line\n  const args = process.argv.slice(2);\n  if (args.includes('--setup') || !cfg.apiKey) {\n    if (!cfg.apiKey) {\n      console.log('⚠️  API Key belum ditemukan! Menjalankan setup interaktif pertama kali...');\n    }\n    await runInteractiveSetup(cfg);\n  }\n\n  console.log('\\nPilihan Menu:');\n  console.log('1. Mulai Terjemahkan (Lanjut / Start)');\n  console.log('2. Ubah Pengaturan (Setup Config)');\n  console.log('3. Keluar');\n\n  const choice = await askQuestion('\\nPilih menu (1/2/3) [1]: ');\n\n  if (choice === '2') {\n    await runInteractiveSetup(cfg);\n    await main();\n  } else if (choice === '3') {\n    process.exit(0);\n  } else {\n    if (!cfg.apiKey) {\n      console.error('❌ Error: API Key wajib diisi!');\n      process.exit(1);\n    }\n    await startTranslation(cfg);\n  }\n}\n\nmain().catch(err => {\n  console.error('\\n❌ Terjadi kesalahan fatal:', err.message);\n  process.exit(1);\n});\n","Overwrite":true,"Path":"C:\\Users\\Eevyx\\Documents\\pdf2zh-app\\termux-translator.mjs"}}]}
