 }\n\n  const chunks = splitIntoParagraphSafeChunks(ch1Lines, 12000);\n  console.log('Total lines:', ch1Lines.length, 'Total chunks:', chunks.length);\n  chunks.forEach((c, i) => console.log('Chunk', i + 1, 'chars:', c.length, 'lines:', c.split('\\n').length));\n}\n\ntestSplit();\n\"","WaitMsBeforeAsync":5000,"toolSummary":"Test chunking of chapter 1"}}]}
