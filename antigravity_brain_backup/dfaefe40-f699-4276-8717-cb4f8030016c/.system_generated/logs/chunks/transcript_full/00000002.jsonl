{"step_index":44,"source":"MODEL","type":"GENERIC","status":"DONE","created_at":"2026-11-11T08:01:15Z","content":"Created At: 2026-11-11T15:01:15+07:00\nCompleted At: 2026-11-11T15:01:15+07:00\nShowing lines 1-150 of 161\n1: #!/usr/bin/env node\n2: /**\n3:  * CLI runner for Light Novel to Markdown (.md) Translator\n4:  *\n5:  * Usage:\n6:  *   npx tsx src/cli/ln-translator.ts <path-to-pdf> [options]\n7:  *\n8:  * Options:\n9:  *   --pages <range>     e.g. 1-10 or 1,2,5 or all (default: all)\n10:  *   --out <path>        Output markdown file path\n11:  *   --model <model>     LLM Model ID (e.g. gpt-4o-mini, gemini-1.5-flash)\n12:  *   --provider <name>   LLM Provider (openai, google, anthropic, etc.)\n13:  *   --token <key>       API key/token\n14:  *   --base-url <url>    Custom base URL\n15:  */\n16: import fs from 'node:fs';\n17: import path from 'node:path';\n18: import os from 'node:os';\n19: import { runLNTranslation } from '../main/pipeline/ln-translator';\n20: import { AppSettings, DEFAULT_SETTINGS } from '../main/pipeline/types';\n21: \n22: function getAppSettings(): AppSettings {\n23:   const appData = process.env.APPDATA || (process.platform === 'darwin' ? path.join(os.homedir(), 'Library/Application Support') : path.join(os.homedir(), '.config'));\n24:   const settingsPath = path.join(appData, 'pdf2zh-app', 'pdf2zh-settings.json');\n25: \n26:   if (fs.existsSync(settingsPath)) {\n27:     try {\n28:       const data = fs.readFileSync(settingsPath, 'utf-8');\n29:       return { ...DEFAULT_SETTINGS, ...JSON.parse(data) };\n30:     } catch {\n31:       // ignore\n32:     }\n33:   }\n34:   return { ...DEFAULT_SETTINGS };\n35: }\n36: \n37: function parsePageRange(rangeStr: string): number[] {\n38:   const pages: Set<number> = new Set();\n39:   const parts = rangeStr.split(',');\n40:   for (const part of parts) {\n41:     const trimmed = part.trim();\n42:     if (trimmed.includes('-')) {\n43:       const [startStr, endStr] = trimmed.split('-');\n44:       const start = parseInt(startStr, 10);\n45:       const end = parseInt(endStr, 10);\n46:       if (!isNaN(start) && !isNaN(end)) {\n47:         for (let i = start; i <= end; i++) {\n48:           pages.add(i);\n49:         }\n50:       }\n51:     } else {\n52:       const p = parseInt(trimmed, 10);\n53:       if (!isNaN(p)) {\n54:         pages.add(p);\n55:       }\n56:     }\n57:   }\n58:   return Array.from(pages).sort((a, b) => a - b);\n59: }\n60: \n61: async function main() {\n62:   const args = process.argv.slice(2);\n63: \n64:   if (args.length === 0 || args.includes('--help') || args.includes('-h')) {\n65:     console.log(`\n66: Light Novel to Markdown (.md) Translator CLI\n67: --------------------------------------------\n68: Usage:\n69:   npx tsx src/cli/ln-translator.ts <path-to-pdf> [options]\n70: \n71: Arguments:\n72:   <path-to-pdf>       Path to the Light Novel PDF file\n73: \n74: Options:\n75:   --pages <range>     Page range to translate, e.g. \"1-20\" or \"1,3,5\" (default: all)\n76:   --out <path>        Output markdown file path (default: <pdf_name>_translated.md)\n77:   --concurrency <n>   Number of concurrent LLM workers (default: 4)\n78:   --chunk-size <n>    Number of pages per chunk (default: 3)\n79:   --provider <name>   LLM Provider (default from settings or 'openai')\n80:   --model <model>     LLM Model ID (default from settings or 'gpt-4o-mini')\n81:   --token <key>       API Token (default from settings or OPENAI_API_KEY env)\n82:   --base-url <url>    Custom Base URL (optional)\n83: \n84: Examples:\n85:   npx tsx src/cli/ln-translator.ts \"novel.pdf\" --pages 1-15\n86:   npx tsx src/cli/ln-translator.ts \"novel.pdf\" --model \"gpt-4o\" --token \"sk-...\"\n87: `);\n88:     process.exit(0);\n89:   }\n90: \n91:   const pdfPath = path.resolve(args[0]);\n92:   if (!fs.existsSync(pdfPath)) {\n93:     console.error(`[Error] File not found: ${pdfPath}`);\n94:     process.exit(1);\n95:   }\n96: \n97:   const settings = getAppSettings();\n98: \n99:   // Parse command line flags\n100:   let selectedPages: number[] | undefined;\n101:   let outputPath: string | undefined;\n102:   let concurrency = 4;\n103:   let chunkPageSize = 3;\n104: \n105:   for (let i = 1; i < args.length; i++) {\n106:     const arg = args[i];\n107:     if (arg === '--pages' && args[i + 1]) {\n108:       selectedPages = parsePageRange(args[++i]);\n109:     } else if (arg === '--out' && args[i + 1]) {\n110:       outputPath = path.resolve(args[++i]);\n111:     } else if (arg === '--concurrency' && args[i + 1]) {\n112:       concurrency = parseInt(args[++i], 10) || 4;\n113:     } else if (arg === '--chunk-size' && args[i + 1]) {\n114:       chunkPageSize = parseInt(args[++i], 10) || 3;\n115:     } else if (arg === '--provider' && args[i + 1]) {\n116:       settings.llmProvider = args[++i];\n117:     } else if (arg === '--model' && args[i + 1]) {\n118:       settings.llmModel = args[++i];\n119:     } else if (arg === '--token' && args[i + 1]) {\n120:       settings.llmApiToken = args[++i];\n121:     } else if (arg === '--base-url' && args[i + 1]) {\n122:       settings.llmBaseUrl = args[++i];\n123:     }\n124:   }\n125: \n126:   // Fallback to environment variables if token not in settings\n127:   if (!settings.llmApiToken) {\n128:     settings.llmApiToken = process.env.OPENAI_API_KEY || process.env.GEMINI_API_KEY || process.env.ANTHROPIC_API_KEY || '';\n129:   }\n130: \n131:   console.log(`Starting LN Translator CLI...`);\n132:   console.log(`Using settings: Provider=${settings.llmProvider}, Model=${settings.llmModel}`);\n133: \n134:   const abortSignal = { aborted: false };\n135:   process.on('SIGINT', () => {\n136:     console.log(`\\nCancellation requested... wrapping up.`);\n137:     abortSignal.aborted = true;\n138:   });\n139: \n140:   try {\n141:     const result = await runLNTranslation({\n142:       inputPath: pdfPath,\n143:       outputPath,\n144:       settings,\n145:       selectedPages,\n146:       concurrency,\n147:       chunkPageSize,\n148:       abortSignal,\n149:     });\n150: "}
