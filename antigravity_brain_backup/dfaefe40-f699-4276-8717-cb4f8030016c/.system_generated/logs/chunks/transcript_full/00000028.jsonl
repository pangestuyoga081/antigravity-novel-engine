st html = fs.readFileSync(full, 'utf-8');\n        let cleanText = html\n          .replace(/<script\\b[^<]*(?:(?!<\\/script>)<[^<]*)*<\\/script>/gi, '')\n          .replace(/<style\\b[^<]*(?:(?!<\\/style>)<[^<]*)*<\\/style>/gi, '')\n          .replace(/<img[^>]+src=['\"]([^'\"]+)['\"][^>]*>/gi, (m, src) => `\\n\\n[[ILUSTRASI:${path.basename(src)}]]\\n\\n`)\n          .replace(/<div class=\"cst\"><b>(.*?)<\\/b><\\/div>/gi, '\\nSubtitle: $1\\n')\n          .replace(/<div class=\"ct\"><b>(.*?)<\\/b><\\/div>/gi, '\\n\\n# $1\\n')\n          .replace(/<h[1-6][^>]*>(.*?)<\\/h[1-6]>/gi, '\\n\\n# $1\\n')\n          .replace(/<p[^>]*>/gi, '\\n')\n          .replace(/<div[^>]*>/gi, '\\n')\n          .replace(/<br\\s*[\\/]?>/gi, '\\n')\n          .replace(/<[^>]+>/g, '')\n          .replace(/&nbsp;/g, ' ')\n          .replace(/&amp;/g, '&')\n          .replace(/&quot;/g, '\"')\n          .replace(/&apos;/g, \"'\")\n          .replace(/&lt;/g, '<')\n          .replace(/&gt;/g, '>')\n          .replace(/\\n\\s*\\n\\s*\\n/g, '\\n\\n')\n          .trim();\n\n        if (cleanText.length > 500) {\n          const lines = cleanText.split('\\n').map(l => l.trim()).filter(l => Boolean(l) && !/^The\\s+Hobbit\\s*$/i.test(l));\n          const firstRealLine = lines[0] || '';\n          if (/^(CONTENTS|TABLE OF CONTENTS|LIST OF ILLUSTRATIONS|NOTE ON THE TEXT|WORKS BY|COPYRIGHT)\\b/i.test(firstRealLine)) continue;\n\n          let title = '';\n          const chIdx = lines.findIndex(l => /^Chapter\\b/i.test(l));\n          if (chIdx !== -1) {\n            const chNum = lines[chIdx + 1] || '';\n            const chName = lines[chIdx + 2] || '';\n            title = `Chapter ${chNum}: ${chName}`;\n          } else if (/Author[’']s Note/i.test(html) || /languages and letters/i.test(html)) {\n            title = \"Catatan Penulis (Author's Note: Runes & Languages)\";\n          } else {\n            for (const l of lines.slice(0, 5)) {\n              const cleanL = l.replace(/^#+\\s*/, '').trim();\n              if (/^(Chapter|Bab|Part)\\b/i.test(cleanL)) {\n                title = cleanL;\n                break;\n              }\n            }\n            if (!title) {\n              title = lines.slice(0, 2).map(l => l.replace(/^#+\\s*/, '').trim()).join(' - ') || ent.name;\n            }\n          }\n\n          chapters.push({\n            id: path.basename(ent.name, path.extname(ent.name)),\n            title,\n            text: cleanWatermarks(cleanText)\n          });\n        }\n      }\n    }\n  }\n\n  scanDir(tempDir);\n  fs.rmSync(tempDir, { recursive: true, force: true });\n  chapters.sort((a, b) => a.id.localeCompare(b.id, undefined, { numeric: true, sensitivity: 'base' }));\n  return chapters;\n}"}}]}
