\\d+(\\s+\\d+)?\\b/gi, '')\n153:     .replace(/\\bMakam Besar Bawah Tanah Nazarick\\b/gi, 'Markas Bawah Tanah')\n154:     .replace(/\\bAbsolute Overlord\\b/gi, 'Penguasa Tertinggi')\n155:     .replace(/\\bSorcerer King\\b/gi, 'Raja Sihir')\n156:     .replace(/\\bSorcerer Kingdom\\b/gi, 'Kerajaan Sihir');\n157: }\n158: \n159: function unmaskCopyrightTokens(text: string): string {\n160:   return text\n161:     .replace(/\\bMarkas Bawah Tanah\\b/gi, 'Makam Besar Bawah Tanah Nazarick')\n162:     .replace(/\\bPenguasa Tertinggi\\b/gi, 'Absolute Overlord')\n163:     .replace(/\\bRaja Sihir\\b/gi, 'Sorcerer King')\n164:     .replace(/\\bKerajaan Sihir\\b/gi, 'Sorcerer Kingdom');\n165: }\n166: \n167: function extractEpubChapters(epubPath: string): Chapter[] {\n168:   console.log('📦 Membaca isi file EPUB...');\n169:   const baseName = path.basename(epubPath, path.extname(epubPath));\n170:   const dirName = path.dirname(epubPath);\n171:   const tempDir = path.join(dirName, '.temp_epub_extract');\n172:   if (fs.existsSync(tempDir)) fs.rmSync(tempDir, { recursive: true, force: true });\n173:   fs.mkdirSync(tempDir, { recursive: true });\n174: \n175:   try {\n176:     execSync(`tar -xf \"${epubPath}\" -C \"${tempDir}\"`, { stdio: 'pipe' });\n177:   } catch (err) {\n178:     throw new Error('Gagal mengekstrak EPUB: ' + err);\n179:   }\n180: \n181:   // Simpan gambar ke folder illustrations/<baseName>\n182:   const illustDir = path.join(dirName, 'illustrations', baseName);\n183:   if (!fs.existsSync(illustDir)) fs.mkdirSync(illustDir, { recursive: true });\n184: \n185:   function copyImages(dir: string) {\n186:     for (const ent of fs.readdirSync(dir, { withFileTypes: true })) {\n187:       const full = path.join(dir, ent.name);\n188:       if (ent.isDirectory()) copyImages(full);\n189:       else if (/\\.(jpe?g|png|webp|gif)$/i.test(ent.name)) {\n190:         fs.copyFileSync(full, path.join(illustDir, ent.name));\n191:       }\n192:     }\n193:   }\n194:   copyImages(tempDir);\n195: \n196:   // Cari berkas OPF untuk membaca urutan canonical spine\n197:   function findOpf(dir: string): string | null {\n198:     for (const ent of fs.readdirSync(dir, { withFileTypes: true })) {\n199:       const full = path.join(dir, ent.name);\n200:       if (ent.isDirectory()) {\n201:         const res = findOpf(full);\n202:         if (res) return res;\n203:       } else if (ent.name.endsWith('.opf')) {\n204:         return full;\n205:       }\n206:     }\n207:     return null;\n208:   }\n209: \n210:   const opfFile = findOpf(tempDir);\n211:   const spineHrefs: string[] = [];\n212:   let opfDir = tempDir;\n213: \n214:   if (opfFile) {\n215:     opfDir = path.dirname(opfFile);\n216:     const opfXml = fs.readFileSync(opfFile, 'utf-8');\n217:     const manifest: Record<string, string> = {};\n218:     for (const itemTag of opfXml.match(/<item\\b[^>]*>/gi) || []) {\n219:       const idM = itemTag.match(/\\bid=[\"']([^\"']+)[\"']/i);\n220:       const hrefM = itemTag.match(/\\bhref=[\"']([^\"']+)[\"']/i);\n221:       if (idM && hrefM) {\n222:         manifest[idM[1]] = hrefM[1];\n223:       }\n224:     }\n225:     const itemrefs = [...opfXml.matchAll(/<itemref