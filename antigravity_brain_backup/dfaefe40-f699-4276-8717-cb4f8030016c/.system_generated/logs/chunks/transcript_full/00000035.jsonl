9:       { no: 31, id: 'chap_31', title: 'BAB 31: Manuver', rx: [/MI[SŞ]CARE/i, /^\\s*(31|3I)\\s*$/] },\n500:       { no: 32, id: 'chap_32', title: 'BAB 32: Bisnis Berdarah', rx: [/AFACERI/i, /^\\s*32\\s*$/] },\n501:       { no: 33, id: 'chap_33', title: 'BAB 33: Permainan Dimulai', rx: [/[IÎ]NCEP\\s*JOCURILE/i, /^\\s*33\\s*$/] },\n502:       { no: 34, id: 'chap_34', title: 'BAB 34: Permainan Berlanjut', rx: [/JOCURILE\\s*CONTINU/i, /^\\s*34\\s*$/] },\n503:       { no: 35, id: 'chap_35', title: 'BAB 35: Maraton', rx: [/MARATONUL/i, /^\\s*35\\s*$/] },\n504:       { no: 36, id: 'chap_36', title: 'BAB 36: Penerbangan Darurat', rx: [/ZBOR\\s*DE\\s*NECESITATE/i, /^\\s*(36|30)\\s*$/] },\n505:       { no: 37, id: 'chap_37', title: 'BAB 37: Api yang Padam', rx: [/FLAC[AĂ]RA/i, /^\\s*37\\s*$/] },\n506:       { no: 38, id: 'chap_38', title: 'BAB 38: Pangkalan Riset', rx: [/STA[TŢ]IUNEA/i, /^\\s*38\\s*$/] },\n507:       { no: 39, id: 'chap_39', title: 'BAB 39: Harmoni', rx: [/ARMONIA/i, /^\\s*39\\s*$/] },\n508:       { no: 40, id: 'epilog', title: 'EPILOG', rx: [/^\\s*(EPILOG|EPILOC)\\s*$/i] }\n509:     ];\n510: \n511:     let lastLine = 520;\n512:     const chapterSlices: Array<typeof chapterMeta[0] & { startLine: number }> = [];\n513: \n514:     for (let i = 0; i < chapterMeta.length; i++) {\n515:       const meta = chapterMeta[i];\n516:       let start = -1;\n517:       for (let j = lastLine; j < lines.length; j++) {\n518:         if (j >= 25030 && j <= 25120) continue;\n519:         if (j >= 48240 && j <= 48350) continue;\n520:         const l = lines[j].trim();\n521:         if (l.length > 50) continue;\n522:         if (meta.rx.some(r => r.test(l))) {\n523:           start = j;\n524:           lastLine = j + 5;\n525:           break;\n526:         }\n527:       }\n528:       chapterSlices.push({ ...meta, startLine: start });\n529:     }\n530: \n531:     const chapters: Chapter[] = [];\n532:     for (let i = 0; i < chapterSlices.length; i++) {\n533:       const cur = chap