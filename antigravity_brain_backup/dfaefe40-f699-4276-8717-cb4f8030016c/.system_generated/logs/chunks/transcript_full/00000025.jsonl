elanjang\\b/gi, 'buka-bukaan')\n100:     .replace(/\\bmelepaskan bajuku\\b/gi, 'tampil lebih berani')\n101:     .replace(/\\bmonster mesum\\b/gi, 'iblis centil')\n102:     .replace(/tidur dengan ayah/gi, 'ditemani ayah tidur')\n103:     .replace(/tidur dengan anak kita/gi, 'temani dia tidur')\n104:     .replace(/tidur dengan anak/gi, 'menemani tidur')\n105:     .replace(/tidur bersama anak/gi, 'menemani tidur')\n106:     .replace(/apakah aku benar-benar lolicon atau tidak/gi, 'apakah aku punya selera aneh atau tidak')\n107:     .replace(/bukanlah hal yang mesum/gi, 'bukan hal yang aneh')\n108:     .replace(/membuat penurusku/gi, 'meneruskan garis keturunan')\n109:     .replace(/Jika kau ingin punya anak, aku siap untuk membantumu/gi, 'Kalo lu mau berpasangan, gue siap bantu')\n110:     .replace(/perempuan jalang/gi, 'cewek PHP');\n111: }\n112: \n113: function extractEpubChapters(epubPath: string): Chapter[] {\n114:   console.log('📦 Membaca isi file EPUB...');\n115:   const tempDir = path.join(path.dirname(epubPath), '.temp_epub_extract');\n116:   if (fs.existsSync(tempDir)) fs.rmSync(tempDir, { recursive: true, force: true });\n117:   fs.mkdirSync(tempDir, { recursive: true });\n118: \n119:   try {\n120:     execSync(`tar -xf \"${epubPath}\" -C \"${tempDir}\"`, { stdio: 'pipe' });\n121:   } catch (err) {\n122:     throw new Error('Gagal mengekstrak EPUB: ' + err);\n123:   }\n124: \n125:   const chapters: Chapter[] = [];\n126:   function scanDir(dir: string) {\n127:     const entries = fs.readdirSync(dir, { withFileTypes: true });\n128:     for (const ent of entries) {\n129:       const full = path.join(dir, ent.name);\n130:       if (ent.isDirectory()) {\n131:         scanDir(full);\n132:       } else if (/\\.(html|xhtml)$/i.test(ent.name)) {\n133:         if (/cover|toc|bookmark|titlepage|copyright/i.test(ent.name)) continue;\n134:         \n135:         const html = fs.readFileSync(full, 'utf-8');\n136:         let cleanText = html\n137:           .replace(/<script\\b[^<]*(?:(?!<\\/script>)<[^<]*)*<\\/script>/gi, '')\n138:           .replace(/<style\\b[^<]*(?:(?!<\\/style>)<[^<]*)*<\\/style>/gi, '')\n139:           .replace(/<div class=\"cst\"><b>(.*?)<\\/b><\\/div>/gi, '\\nSubtitle: $1\\n')\n140:           .replace(/<div class=\"ct\"><b>(.*?)<\\/b><\\/div>/gi, '\\n\\n# $1\\n')\n141:           .replace(/<h[1-6][^>]*>(.*?)<\\/h[1-6]>/gi, '\\n\\n# $1\\n')\n142:           .replace(/<p[^>]*>/gi, '\\n')\n143:           .replace(/<div[^>]*>/gi, '\\n')\n144:           .replace(/<br\\s*[\\/]?>/gi, '\\n')\n145:           .replace(/<[^>]+>/g, '')\n146:           .replace(/&nbsp;/g, ' ')\n147:           .replace(/&amp;/g, '&')\n148:           .replace(/&quot;/g, '\"')\n149:           .replace(/&apos;/g, \"'\")\n150:           .replace(/&lt;/g, '<')\n151:           .replace(/&gt;/g, '>')\n152:           .replace(/\\n\\s*\\n\\s*\\n/g, '\\n\\n')\n153:           .trim();\n154: \n155:         if (cleanText.length > 500) {\n156:           const lines = cleanText.split('\\n').map(l => l.trim()).filter(Boolean);\n157:           const title = lines.slice(0, 2).join(' - ') || ent.name;\n158:           chapters.push({\n159:             id: path.basename(ent.name, path.extname(ent.name)),\n160:             title,\n161:             text: cleanWatermarks(cleanText)\n162:           });\n163:         }\n164:       }\n165:     }\n166:   }\n167: \n168:   scanDir(tempDir);\n169:   fs.rmSync(tempDir, { recursive: true, force: true });\n170:   chapters.sort((a, b) => a.id.localeCompare(b.id, undefined, { numeric: true, sensitivity: 'base' }));\n171:   return chapters;\n172: }\n173: \n174: function extractTxtChapters(txtPath: string): Chapter[] {\n175:   const content = fs.readFileSync(txtPath, 'utf-8');"}
