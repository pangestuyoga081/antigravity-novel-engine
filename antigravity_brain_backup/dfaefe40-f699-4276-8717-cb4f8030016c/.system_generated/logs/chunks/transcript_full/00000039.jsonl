{"step_index":2936,"source":"MODEL","type":"PLANNER_RESPONSE","status":"DONE","created_at":"2026-11-19T02:49:21Z","input_tokens":2619,"cache_read_tokens":130725,"output_tokens":695,"tool_calls":[{"name":"write_file","args":{"Content":"import zipfile\nimport re\nimport html\nfrom html.parser import HTMLParser\n\nclass TextExtractor(HTMLParser):\n    def __init__(self):\n        super().__init__()\n        self.result = []\n        self.skip = False\n\n    def handle_starttag(self, tag, attrs):\n        if tag in ('script', 'style'):\n            self.skip = True\n        elif tag in ('p', 'div', 'br', 'h1', 'h2', 'h3', 'h4', 'li', 'tr'):\n            self.result.append('\\n')\n\n    def handle_endtag(self, tag):\n        if tag in ('script', 'style'):\n            self.skip = False\n        elif tag in ('p', 'div', 'h1', 'h2', 'h3', 'h4', 'tr'):\n            self.result.append('\\n')\n\n    def handle_data(self, data):\n        if not self.skip:\n            self.result.append(data)\n\n    def get_text(self):\n        text = ''.join(self.result)\n        text = re.sub(r'[ \\t]+', ' ', text)\n        text = re.sub(r'\\n\\s*\\n', '\\n\\n', text)\n        return text.strip()\n\nepub_path = r\"D:\\JV\\novel yoga\\Fifty_Shades_of_Grey_-_E_L_James.epub\"\n\nwith zipfile.ZipFile(epub_path, 'r') as z:\n    # Cari file HTML yang berisi Chapter One / Chapter 1\n    html_files = [f for f in z.namelist() if f.lower().endswith(('.html', '.xhtml'))]\n    print(f\"Total HTML files: {len(html_files)}\")\n    \n    chap1_file = None\n    chap1_text = \"\"\n    for hf in sorted(html_files):\n        content = z.read(hf).decode('utf-8', errors='ignore')\n        if 'CHAPTER ONE' in content.upper() or 'CHAPTER 1' in content.upper():\n            parser = TextExtractor()\n            parser.feed(content)\n            txt = parser.get_text()\n            chap1_file = hf\n            chap1_text = txt\n            break\n\n    if chap1_file:\n        print(f\"Ditemukan Bab 1 di: {chap1_file} ({len(chap1_text)} karakter)\")\n        with open(r\"D:\\JV\\novel yoga\\fifty_shades_ch1_sample.txt\", \"w\", encoding=\"utf-8\") as out:\n            out.write(chap1_text)\n        print(\"Tersimpan ke D:\\\\JV\\\\novel yoga\\\\fifty_shades_ch1_sample.txt\")\n    else:\n        print(\"Chapter 1 tidak ditemukan via regex sederhana, memeriksa spine...\")\n","Path":"D:/JV/novel yoga/extract_ch1.py"}}]}
