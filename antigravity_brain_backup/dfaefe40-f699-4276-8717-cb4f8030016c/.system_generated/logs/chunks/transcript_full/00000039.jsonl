t(f\"Total karakter Bab 1: {len(ch1_text)}\")\n    \n    with open(r\"D:\\JV\\novel yoga\\Fifty_Shades_Bab_01_Sample.txt\", \"w\", encoding=\"utf-8\") as out:\n        out.write(\"### BAB 1: Wawancara Christian Grey\\n\\n\" + ch1_text)\n    print(\"Berhasil disimpan ke D:\\\\JV\\\\novel yoga\\\\Fifty_Shades_Bab_01_Sample.txt\")\n","Path":"D:/JV/novel yoga/prepare_ch1.py"}}]}
