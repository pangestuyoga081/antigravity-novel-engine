{"step_index":2882,"source":"MODEL","type":"GENERIC","status":"DONE","created_at":"2026-11-18T09:16:37Z","content":"Created At: 2026-11-18T16:16:37+07:00\nCompleted At: 2026-11-18T16:16:38+07:00\nCreated At: 2026-11-18T16:16:37+07:00\nCompleted At: 2026-11-18T16:16:38+07:00\nCommand exited with code 0.\n\nCommand output:\n    html_parts = []\r\n    \r\n    for p in paragraphs:\r\n        p = p.strip()\r\n        if not p:\r\n            continue\r\n            \r\n        img_match = re.match(r\"^\\[\\[ILUSTRASI:(.*?)\\]\\]$\", p)\r\n        if img_match:\r\n            img_file = img_match.group(1)\r\n            base_img = os.path.basename(img_file)\r\n            html_parts.append(f'<div class=\"illustration-container\"><img src=\"../images/{base_img}\" alt=\"Ilustrasi\" /></div>')\r\n            continue\r\n            \r\n        spk_match = re.match(r\"^([^:]+?):\\s*\\\"(.*)\\\"$\", p)\r\n        if spk_match:\r\n            spk = html.escape(spk_match.group(1))\r\n            dial = html.escape(spk_match.group(2))\r\n            html_parts.append(f'<p class=\"dialogue\"><span class=\"speaker\">{spk}:</span> &ldquo;{dial}&rdquo;</p>')\r\n            continue\r\n            \r\n        esc_p = html.escape(p)\r\n        esc_p = re.sub(r\"\\*\\*(.*?)\\*\\*\", r\"<strong>\\1</strong>\", esc_p)\r\n        esc_p = re.sub(r\"\\*(.*?)\\*\", r\"<em>\\1</em>\", esc_p)\r\n        html_parts.append(f\"<p>{esc_p}</p>\")\r\n        \r\n    return \"\\n\".join(html_parts)\r\n\r\ndef main():\r\n    if len(sys.argv) < 4:\r\n        print(\"Usage: python compile_epub_helper.py <txt_file> <src_epub> <out_epub>\")\r\n        sys.exit(1)\r\n\r\n    txt_file = sys.argv[1]\r\n    src_epub = sys.argv[2]\r\n    out_epub = sys.argv[3]\r\n\r\n    base_name = os.path.splitext(os.path.basename(src_epub))[0]\r\n    base_dir = os.path.dirname(os.path.abspath(txt_file))\r\n    with open(txt_file, \"r\", encoding=\"utf-8\") as f:\r\n        full_text = f.read()\r\n\r\n    # Extract all images from source epub or illustrations directory\r\n    images_data = {}\r\n    if os.path.isfile(src_epub) and src_epub.lower().endswith(\".epub\"):\r\n        with zipfile.ZipFile(src_epub, \"r\") as z:\r\n            for n in z.namelist():\r\n                if n.lower().endswith((\".jpg\", \".jpeg\", \".png\", \".gif\", \".webp\")):\r\n                    bn = os.path.basename(n)\r\n                    images_data[bn] = z.read(n)\r\n\r\n    # Selalu muat juga gambar dari folder illustrations terkait jika ada\r\n    search_dirs = [\r\n        os.path.join(base_dir, \"illustrations\", base_name),\r\n        os.path.join(base_dir, \"illustrations\", base_name.replace(\" \", \"_\"))\r\n    ]\r\n    for sdir in search_dirs:\r\n        if os.path.isdir(sdir):\r\n            for root, _, files in os.walk(sdir):\r\n                for fn in files:\r\n                    if fn.lower().endswith((\".jpg\", \".jpeg\", \".png\", \".gif\", \".webp\")):\r\n                        if fn not in images_data:\r\n                            with open(os.path.join(root, fn), \"rb\") as f:\r\n                                images_data[fn] = f.read()\r\n\r\n    print(f\"ðŸ–¼ï¸ Ditemukan {len(images_data)} berkas gambar untuk EPUB.\")\r\n\r\n    # Parse chapters\r\n    sections = re.split(r\"(?=^###\\s+)\", full_text, flags=re.MULTILINE)\r\n    chapters = []\r\n    for s in sections:\r\n        s = s.strip()\r\n        if not s.startswith(\"###\"):\r\n            continue\r\n        lines = s.split(\"\\n\")\r\n        raw_title = lines[0].replace(\"###\", \"\").strip()\r\n        title = re.sub(r\"^([=*\\s]+)\", \"\", raw_title).strip()\r\n        body = \"\\n\".join(lines[1:]).strip()\r\n        # Clean separator lines\r\n        body = re.sub(r\"^={10,}\\s*$\", \"\", body, flags=re.MULTILINE)\r\n        if len(body) > 100:\r\n            chapters.append({\"title\": title, \"body\": body})\r\n\r\n    print(f\"ðŸ“š Terdeteksi {len(chapters)} bab cerita.\")\r\n\r\n    xhtml_files = []\r\n\r\n    # Galeri Peta Pembuka (Khusus Hobbit jika ada file petanya)\r\n    if \"00003.jpeg\" in images_data or \"00021.jpeg\" in images_data:\r\n        maps_html = ['<div class=\"color-gallery\"><h1>Peta &amp; Ilustrasi Middle-earth</h1>']\r\n"}
{"step_index":2883,"source":"MODEL","type":"PLANNER_RESPONSE","status":"DONE","created_at":"2026-11-18T09:16:39Z","input_tokens":2405,"cache_read_tokens":115387,"output_tokens":2292,"tool_calls":[{"name":"run_command","args":{"CommandLine":"python -c \"\nimport os, sys, re, zipfile, html\n\ntxt_file = r'D:\\JV\\novel yoga\\Tom Clancy - 09. Rainbow six - vol. 1+2 (Terjemahan ID-Direct).txt'\nout_epub = r'D:\\JV\\novel yoga\\epubs\\Tom Clancy - Rainbow Six (Vol 1+2) (Illustrated ID-Direct).epub'\n\nos.makedirs(os.path.dirname(out_epub), exist_ok=True)\n\nwith open(txt_file, 'r', encoding='utf-8') as f:\n    full_text = f.read()\n\n# Parse chapters\nsections = re.split(r'(?=^###\\s+)', full_text, flags=re.MULTILINE)\nchapters = []\nfor s in sections:\n    s = s.strip()\n    if not s.startswith('###'):\n        continue\n    lines = s.split('\\n')\n    raw_title = lines[0].replace('###', '').strip()\n    title = re.sub(r'^([=*\\s]+)', '', raw_title).strip()\n    body = '\\n'.join(lines[1:]).strip()\n    body = re.sub(r'^={10,}\\s*$', '', body, flags=re.MULTILINE)\n    if len(body) > 100:\n        chapters.append({'title': title, 'body': body})\n\nprint(f'Total bab terdeteksi: {len(chapters)}')\n\nCSS_CONTENT = '''@charset \\\"utf-8\\\";\nbody {\n    margin: 5% 8%;\n    font-family: -apple-system, BlinkMacSystemFont, \\\"Segoe UI\\\", Roboto, Helvetica, Arial, sans-serif;\n    line-height: 1.8;\n    color: #2b2b2b;\n    background-color: #fafafa;\n    text-align: justify;\n}\nh1, h2, h3 {\n    text-align: center;\n    color: #1a1a1a;\n    margin-top: 1.5em;\n    margin-bottom: 1em;\n    font-weight: 700;\n}\np {\n    margin: 0.8em 0;\n    text-indent: 1.5em;\n}\np.dialogue {\n    text-indent: 0;\n    margin-left: 0.5em;\n    font-weight: 500;\n}\n.speaker {\n    font-weight: 700;\n    color: #8b3a00;\n}\n'''\n\ndef text_to_html(body_text):\n    paragraphs = body_text.split('\\n')\n    html_parts = []\n    for p in paragraphs:\n        p = p.strip()\n        if not p: continue\n        spk_match = re.match(r'^([^:]+?):\\s*\\\"(.*)\\\"$', p)\n        if spk_match:\n            spk = html.escape(spk_match.group(1))\n            dial = html.escape(spk_match.group(2))\n            html_parts.append(f'<p class=\\\"dialogue\\\"><span class=\\\"speaker\\\">{spk}:</span> &ldquo;{dial}&rdquo;</p>')\n            continue\n        esc_p = html.escape(p)\n        esc_p = re.sub(r'\\*\\*(.*?)\\*\\*', r'<strong>\\1</strong>', esc_p)\n        esc_p = re.sub(r'\\*(.*?)\\*', r'<em>\\1</em>', esc_p)\n        html_parts.append(f'<p>{esc_p}</p>')\n    return '\\n'.join(html_parts)\n\nwith zipfile.ZipFile(out_epub, 'w', compression=zipfile.ZIP_DEFLATED) as z:\n    z.writestr('mimetype', 'application/epub+zip', compress_type=zipfile.ZIP_STORED)\n    \n    container_xml = '''<?xml version=\\\"1.0\\\" encoding=\\\"UTF-8\\\"?>\n<container version=\\\"1.0\\\" xmlns=\\\"urn:oasis:names:tc:opendocument:xmlns:container\\\">\n    <rootfiles>\n        <rootfile full-path=\\\"OEBPS/content.opf\\\" media-type=\\\"application/oebps-package+xml\\\"/>\n    </rootfiles>\n</container>'''\n    z.writestr('META-INF/container.xml', container_xml)\n    z.writestr('OEBPS/css/stylesheet.css', CSS_CONTENT)\n\n    manifest_items = []\n    spine_items = []\n    toc_ncx_items = []\n    nav_html_items = []\n\n    for idx, ch in enumerate(chapters, start=1):\n        filename = f'chapter_{idx:03d}.xhtml'\n        cid = f'chap_{idx:03d}'\n        ch_title = html.escape(ch['title'])\n        body_html = text_to_html(ch['body'])\n        \n        content = f'''<?xml version=\\\"1.0\\\" encoding=\\\"utf-8\\\"?>\n<!DOCTYPE html>\n<html xmlns=\\\"http://www.w3.org/1999/xhtml\\\" xmlns:epub=\\\"http://www.idpf.org/2007/ops\\\">\n<head>\n    <title>{ch_title}</title>\n    <link rel=\\\"stylesheet\\\" type=\\\"text/css\\\" href=\\\"css/stylesheet.css\\\"/>\n</head>\n<body>\n    <h1>{ch_title}</h1>\n    {body_html}\n</body>\n</html>'''\n        z.writestr(f'OEBPS/{filename}', content)\n        manifest_items.append(f'<item id=\\\"{cid}\\\" href=\\\"{filename}\\\" media-type=\\\"application/xhtml+xml\\\"/>\\n')\n        spine_items.append(f'<itemref idref=\\\"{cid}\\\"/>\\n')\n        toc_ncx_items.append(f'<navPoint id=\\\"nav_{cid}\\\" playOrder=\\\"{idx}\\\"><navLabel><text>{ch_title}</text></navLabel><content src=\\\"{filename}\\\"/></navPoint>\\n')\n        nav_html_items.append(f'<li><a href=\\\"{filename}\\\">{ch_title}</a></li>\\n')\n\n    book_title = 'Tom Clancy: Rainbow Six (Vol. 1+2)'\n    author = 'Tom Clancy'\n    book_uid = 'urn:uuid:tom-clancy-rainbow-six-vol-1-2'\n\n    toc_ncx = f'''<?xml version=\\\"1.0\\\" encoding=\\\"UTF-8\\\"?>\n<ncx xmlns=\\\"http://www.daisy.org/z3986/2005/ncx/\\\" version=\\\"2005-1\\\">\n    <head>\n        <meta name=\\\"dtb:uid\\\" content=\\\"{book_uid}\\\"/>\n        <meta name=\\\"dtb:depth\\\" content=\\\"1\\\"/>\n        <meta name=\\\"dtb:totalPageCount\\\" content=\\\"0\\\"/>\n        <meta name=\\\"dtb:maxPageNumber\\\" content=\\\"0\\\"/>\n    </head>\n    <docTitle><text>{book_title}</text></docTitle>\n    <navMap>{\\\"\\\".join(toc_ncx_items)}</navMap>\n</ncx>'''\n    z.writestr('OEBPS/toc.ncx', toc_ncx)\n\n    nav_xhtml = f'''<?xml version=\\\"1.0\\\" encoding=\\\"utf-8\\\"?>\n<!DOCTYPE html>\n<html xmlns=\\\"http://www.w3.org/1999/xhtml\\\" xmlns:epub=\\\"http://www.idpf.org/2007/ops\\\">\n<head><title>Daftar Isi</title><link rel=\\\"stylesheet\\\" type=\\\"text/css\\\" href=\\\"css/stylesheet.css\\\"/></head>\n<body><nav epub:type=\\\"toc\\\" id=\\\"toc\\\"><h1>Daftar Isi</h1><ol>{\\\"\\\".join(nav_html_items)}</ol></nav></body>\n</html>'''\n    z.writestr('OEBPS/nav.xhtml', nav_xhtml)\n\n    content_opf = f'''<?xml version=\\\"1.0\\\" encoding=\\\"UTF-8\\\"?>\n<package xmlns=\\\"http://www.idpf.org/2007/opf\\\" unique-identifier=\\\"BookID\\\" version=\\\"3.0\\\">\n    <metadata xmlns:dc=\\\"http://purl.org/dc/elements/1.1/\\\">\n        <dc:title>{book_title}</dc:title>\n        <dc:creator>{author}</dc:creator>\n        <dc:language>id</dc:language>\n        <dc:identifier id=\\\"BookID\\\">{book_uid}</dc:identifier>\n    </metadata>\n    <manifest>\n        <item id=\\\"ncx\\\" href=\\\"toc.ncx\\\" media-type=\\\"application/x-dtbncx+xml\\\"/>\n        <item id=\\\"nav\\\" href=\\\"nav.xhtml\\\" media-type=\\\"application/xhtml+xml\\\" properties=\\\"nav\\\"/>\n        <item id=\\\"css\\\" href=\\\"css/stylesheet.css\\\" media-type=\\\"text/css\\\"/>\n        {\\\"\\\".join(manifest_items)}\n    </manifest>\n    <spine toc=\\\"ncx\\\">{\\\"\\\".join(spine_items)}</spine>\n</package>'''\n    z.writestr('OEBPS/content.opf', content_opf)\n\nsz_mb = os.path.getsize(out_epub) / (1024 * 1024)\nprint(f'Sukses dibuat: {out_epub} ({sz_mb:.2f} MB)')\n\"","WaitMsBeforeAsync":15000,"toolSummary":"Compile Tom Clancy EPUB"}}]}
