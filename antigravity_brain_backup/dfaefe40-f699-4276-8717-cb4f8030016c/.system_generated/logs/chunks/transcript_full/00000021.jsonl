images = [m for m in images_meta if not m[\"is_color\"]]\n189:     color_images = [m[\"filename\"] for m in images_meta if m[\"is_color\"]]\n190:     \n191:     for bw in bw_images:\n192:         inserted = False\n193:         # Ekstrak kata kunci dari prev dan next text\n194:         context_words = re.findall(r\"\\b[A-Za-zÀ-ÿ]{4,}\\b\", f\"{bw['prev_text']} {bw['next_text']}\")\n195:         # Buang kata umum\n196:         stopwords = {\"yang\", \"dengan\", \"untuk\", \"dalam\", \"tidak\", \"adalah\", \"pada\", \"dari\", \"ruidrive\", \"volume\"}\n197:         keywords = [w for w in context_words if w.lower() not in stopwords]\n198:         \n199:         # Cari bab yang paling cocok\n200:         best_ch = None\n201:         best_score = 0\n202:         best_para_idx = -1\n203:         \n204:         for ch in chapters:\n205:             paras = ch[\"body\"].split(\"\\n\")\n206:             for p_idx, p in enumerate(paras):\n207:                 score = sum(1 for kw in keywords if kw.lower() in p.lower())\n208:                 if score > best_score:\n209:                     best_score = score\n210:                     best_ch = ch\n211:                     best_para_idx = p_idx\n212:                     \n213:         if best_ch and best_score >= 2:\n214:             paras = best_ch[\"body\"].split(\"\\n\")\n215:             paras.insert(best_para_idx + 1, f\"[[ILUSTRASI:{bw['filename']}]]\")\n216:             best_ch[\"body\"] = \"\\n\".join(paras)\n217:             inserted = True\n218:         else:\n219:             # Fallback relatif: masukkan berdasarkan estimasi posisi halaman\n220:             est_ch_idx = min(len(chapters) - 1, int((bw[\"page\"] / total_pages) * len(chapters)))\n221:             target_ch = chapters[est_ch_idx]\n222:             paras = target_ch[\"body\"].split(\"\\n\")\n223:             insert_pos = int(len(paras) * 0.5)\n224:             paras.insert(insert_pos, f\"[[ILUSTRASI:{bw['filename']}]]\")\n225:             target_ch[\"body\"] = \"\\n\".join(paras)\n226: \n227:     # 4. Susun EPUB\n228:     epub_out = os.path.join(EPUB_OUT_DIR, f\"Rokudenashi Majutsu Koushi to Akashic Records - Volume {vol_num:02d} (Illustrated).epub\")\n229:     \n230:     xhtml_files = []\n231:     \n232:     # Galeri Warna\n233:     if color_images:\n234:         color_html_parts = ['<div class=\"color-gallery\"><h1>Ilustrasi Berwarna</h1>']\n235:         for c_img in color_images:\n236:             color_html_parts.append(f'<div class=\"illustration-container\"><img src=\"../images/{c_img}\" alt=\"Ilustrasi Warna\" /></div>')\n237:         color_html_parts.append('</div>')\n238:         color_xhtml = f\"\"\"<?xml version=\"1.0\" encoding=\"utf-8\"?>\n239: <!DOCTYPE html>\n240: <html xmlns=\"http://www.w3.org/1999/xhtml\" xmlns:epub=\"http://www.idpf.org/2007/ops\">\n241: <head>\n242: <title>Galeri Ilustrasi Berwarna</title>\n243: <link rel=\"stylesheet\" type=\"text/css\" href=\"../css/stylesheet.css\"/>\n244: </head>\n245: <body>\n246: {\"\".join(color_html_parts)}\n247: </body>\n248: </html>\"\"\"\n249:         xhtml_files.append((\"gallery.xhtml\", \"Galeri Ilustrasi Berwarna\", color_xhtml))\n250: \n251:     # Bab Cerita\n252:     for idx, ch in enumerate(chapters):\n253:         fname = f\"chapter_{idx+1:02d}.xhtml\"\n254:         title_esc = html.escape(ch[\"title\"])\n255:         body_html = text_to_html(ch[\"body\"])\n256:         \n257:         doc_xhtml = f\"\"\"<?xml version=\"1.0\" encoding=\"utf-8\"?>\n258: <!DOCTYPE html>\n259: <html xmlns=\"http://www.w3.org/1999/xhtml\" xmlns:epub=\"http://www.idpf.org/2007/ops\">\n260: <head>\n261: <title>{title_esc}</title>\n262: <link rel=\"stylesheet\" type=\"text/css\" href=\"../css/stylesheet.css\"/>\n263: </head>\n264: <body>\n265: <h2>{title_esc}</h2>\n266: {body_html}\n267: </body>\n268: </html>\"\"\"\n269:         xhtml_files.append((fname, ch[\"title\"], doc_xhtml))\n270: \n271:     # Tulis ke file ZIP EPUB\n272:     with zipfile.ZipFile(epub_out, \"w\")