{"step_index":1413,"source":"MODEL","type":"GENERIC","status":"DONE","created_at":"2026-11-13T03:06:09Z","content":"Created At: 2026-11-13T10:06:09+07:00\nCompleted At: 2026-11-13T10:06:11+07:00\nShowing lines 1-150 of 395\n1: import os\n2: import re\n3: import json\n4: import zipfile\n5: import html\n6: import glob\n7: import time\n8: from concurrent.futures import ThreadPoolExecutor, as_completed\n9: import pymupdf\n10: \n11: BASE_DIR = r\"D:\\JV\\novel yoga\"\n12: COMBINED_TXT = os.path.join(BASE_DIR, \"Rokudenashi Majutsu Koushi to Akashic Records - Volume 01-24 (ID-Gaul-Combined).txt\")\n13: PDF_SEARCH_ROOT = r\"D:\\JV\\[Ruidrive] Rokudenashi Majutsu Koushi to Akashic Records\\[Ruidrive] Rokudenashi Majutsu Koushi to Akashic Records\"\n14: EPUB_OUT_DIR = os.path.join(BASE_DIR, \"epubs\")\n15: ILLUST_CACHE_ROOT = os.path.join(BASE_DIR, \"illustrations\")\n16: \n17: os.makedirs(EPUB_OUT_DIR, exist_ok=True)\n18: os.makedirs(ILLUST_CACHE_ROOT, exist_ok=True)\n19: \n20: CSS_CONTENT = \"\"\"@charset \"utf-8\";\n21: body {\n22:     margin: 5% 8%;\n23:     font-family: -apple-system, BlinkMacSystemFont, \"Segoe UI\", Roboto, Helvetica, Arial, sans-serif;\n24:     line-height: 1.8;\n25:     color: #2b2b2b;\n26:     background-color: #fafafa;\n27:     text-align: justify;\n28: }\n29: h1, h2, h3 {\n30:     text-align: center;\n31:     color: #1a1a1a;\n32:     margin-top: 1.5em;\n33:     margin-bottom: 1em;\n34:     font-weight: 700;\n35: }\n36: p {\n37:     margin: 0.8em 0;\n38:     text-indent: 1.5em;\n39: }\n40: p.dialogue {\n41:     text-indent: 0;\n42:     margin-left: 0.5em;\n43:     font-weight: 500;\n44: }\n45: .speaker {\n46:     font-weight: 700;\n47:     color: #0d47a1;\n48: }\n49: .illustration-container {\n50:     text-align: center;\n51:     margin: 2em 0;\n52:     page-break-inside: avoid;\n53: }\n54: .illustration-container img {\n55:     max-width: 100%;\n56:     height: auto;\n57:     border-radius: 4px;\n58:     box-shadow: 0 4px 10px rgba(0,0,0,0.15);\n59: }\n60: .color-gallery {\n61:     text-align: center;\n62:     page-break-after: always;\n63: }\n64: .color-gallery img {\n65:     max-width: 100%;\n66:     max-height: 90vh;\n67:     height: auto;\n68:     margin: 1em auto;\n69: }\n70: \"\"\"\n71: \n72: def text_to_html(body_text):\n73:     paragraphs = body_text.split(\"\\n\")\n74:     html_parts = []\n75:     \n76:     for p in paragraphs:\n77:         p = p.strip()\n78:         if not p:\n79:             continue\n80:             \n81:         img_match = re.match(r\"\\[\\[ILUSTRASI:(.*?)\\]\\]\", p)\n82:         if img_match:\n83:             img_file = img_match.group(1)\n84:             html_parts.append(f'<div class=\"illustration-container\"><img src=\"../images/{img_file}\" alt=\"Ilustrasi\" /></div>')\n85:             continue\n86:             \n87:         spk_match = re.match(r\"^([^:]+?):\\s*\\\"(.*)\\\"$\", p)\n88:         if spk_match:\n89:             spk = html.escape(spk_match.group(1))\n90:             dial = html.escape(spk_match.group(2))\n91:             html_parts.append(f'<p class=\"dialogue\"><span class=\"speaker\">{spk}:</span> &ldquo;{dial}&rdquo;</p>')\n92:             continue\n93:             \n94:         esc_p = html.escape(p)\n95:         esc_p = re.sub(r\"\\*\\*(.*?)\\*\\*\", r\"<strong>\\1</strong>\", esc_p)\n96:         esc_p = re.sub(r\"\\*(.*?)\\*\", r\"<em>\\1</em>\", esc_p)\n97:         html_parts.append(f\"<p>{esc_p}</p>\")\n98:         \n99:     return \"\\n\".join(html_parts)\n100: \n101: def find_pdf_for_volume(vol_num):\n102:     target_str = f\"Volume {vol_num:02d}\"\n103:     for root, dirs, files in os.walk(PDF_SEARCH_ROOT):\n104:         for f in files:\n105:             if f.lower().endswith(\".pdf\") and target_str.lower() in f.lower():\n106:                 return os.path.join(root, f)\n107:     return None\n108: \n109: def process_single_volume(vol_num, vol_raw_text):\n110:     vol_str = f\"Volume {vol_num:02d}\"\n111:     print(f\"🚀 Memproses {vol_str}...\")\n112:     \n113:     pdf_path = find_pdf_for_volume(vol_num)\n114:     if not pdf_path:\n115:         print(f\"❌ PDF untuk {vol_str} tidak ditemukan!\")\n116:         return False\n117: \n118:     vol_img_dir = os.path.join(ILLUST_CACHE_ROOT, f\"Rokudenashi_Vol{vol_num:02d}\")\n119:     os.makedirs(vol_img_dir, exist_ok=True)\n120:     \n121:     # 1. Ekstraksi Gambar dari PDF\n122:     doc = pymupdf.open(pdf_path)\n123:     total_pages = len(doc)\n124:     \n125:     images_meta = []\n126:     for page_num in range(total_pages):\n127:         page = doc[page_num]\n128:         image_list = page.get_images(full=True)\n129:         \n130:         for img_idx, img_info in enumerate(image_list):\n131:             xref = img_info[0]\n132:             base_img = doc.extract_image(xref)\n133:             w, h = base_img[\"width\"], base_img[\"height\"]\n134:             ext = base_img[\"ext\"]\n135:             img_bytes = base_img[\"image\"]\n136:             size_kb = len(img_bytes) / 1024\n137:             \n138:             if w > 300 and h > 300 and size_kb > 30:\n139:                 img_filename = f\"vol{vol_num:02d}_p{page_num + 1:03d}_{xref}.{ext}\"\n140:                 img_save_path = os.path.join(vol_img_dir, img_filename)\n141:                 \n142:                 if not os.path.exists(img_save_path):\n143:                     with open(img_save_path, \"wb\") as f:\n144:                         f.write(img_bytes)\n145:                 \n146:                 # Context teks\n147:                 prev_text = \"\"\n148:                 if page_num > 0:\n149:                     pt = doc[page_num - 1].get_text(\"text\").strip().split(\"\\n\")\n150:                     prev_text = \" \".join([l.strip() for l in pt if l.strip() and not l.startswith(\"Volume\") and \"ruidrive\" not in l.lower()][-3:])"}
