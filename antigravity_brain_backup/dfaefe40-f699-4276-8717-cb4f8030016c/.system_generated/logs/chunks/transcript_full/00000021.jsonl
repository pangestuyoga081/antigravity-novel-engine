A VOLUME 01-24 EPUB BERILUSTRASI\")\n360:     print(\"==================================================================\")\n361:     \n362:     with open(COMBINED_TXT, \"r\", encoding=\"utf-8\") as f:\n363:         full_text = f.read()\n364: \n365:     # Split text into 24 volumes\n366:     vol_matches = list(re.finditer(r\"ROKUDENASHI MAJUTSU KOUSHI TO AKASHIC RECORDS - VOLUME\\s+(\\d+)\", full_text, re.IGNORECASE))\n367:     print(f\"Ditemukan {len(vol_matches)} volume di teks gabungan.\")\n368: \n369:     vol_slices = []\n370:     for idx in range(len(vol_matches)):\n371:         v_num = int(vol_matches[idx].group(1))\n372:         start_pos = vol_matches[idx].start()\n373:         end_pos = vol_matches[idx + 1].start() if idx + 1 < len(vol_matches) else len(full_text)\n374:         slice_text = full_text[start_pos:end_pos]\n375:         vol_slices.append((v_num, slice_text))\n376: \n377:     t0 = time.time()\n378:     # Jalankan batch paralel dengan 6 worker\n379:     with ThreadPoolExecutor(max_workers=6) as executor:\n380:         futures = {executor.submit(process_single_volume, v_num, txt): v_num for v_num, txt in vol_slices}\n381:         for fut in as_completed(futures):\n382:             v_num = futures[fut]\n383:             try:\n384:                 fut.result()\n385:             except Exception as e:\n386:                 print(f\"❌ Error pada Volume {v_num}: {e}\")\n387: \n388:     total_time = time.time() - t0\n389:     print(\"\\n==================================================================\")\n390:     print(f\"🎉 SEMUA 24 VOLUME EPUB SUKSES DIBUAT DALAM {total_time:.1f} DETIK!\")\n391:     print(f\"📁 Folder Output: {EPUB_OUT_DIR}\")\n392:     print(\"==================================================================\")\n393: \n394: if __name__ == \"__main__\":\n395:     main()"}
