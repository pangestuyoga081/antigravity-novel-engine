{"step_index":4167,"source":"MODEL","type":"GENERIC","status":"DONE","created_at":"2026-11-20T02:45:27Z","content":"Created At: 2026-11-20T09:45:27+07:00\nCompleted At: 2026-11-20T09:45:28+07:00\nCreated At: 2026-11-20T09:45:27+07:00\nCompleted At: 2026-11-20T09:45:28+07:00\nShowing lines 150-250 of 1507\n150:     .replace(/membuat penurusku/gi, 'meneruskan garis keturunan')\r\n151:     .replace(/Jika kau ingin punya anak, aku siap untuk membantumu/gi, 'Kalo lu mau berpasangan, gue siap bantu')\r\n152:     .replace(/perempuan jalang/gi, 'cewek PHP');\r\n153: }\r\n154: \r\n155: function maskCopyrightTokens(text: string): string {\r\n156:   return text\r\n157:     .replace(/^\\s*Overlord\\s*[–—\\-]\\s*Volume\\s*\\d+\\s*$/gmi, '')\r\n158:     .replace(/\\bOVERLORD\\s*[–—\\-]?\\s*VOLUME\\s*\\d+(\\s+\\d+)?\\b/gi, '')\r\n159:     .replace(/\\bMakam Besar Bawah Tanah Nazarick\\b/gi, 'Markas Bawah Tanah')\r\n160:     .replace(/\\bAbsolute Overlord\\b/gi, 'Penguasa Tertinggi')\r\n161:     .replace(/\\bSorcerer King\\b/gi, 'Raja Sihir')\r\n162:     .replace(/\\bSorcerer Kingdom\\b/gi, 'Kerajaan Sihir');\r\n163: }\r\n164: \r\n165: function unmaskCopyrightTokens(text: string): string {\r\n166:   return text\r\n167:     .replace(/\\bMarkas Bawah Tanah\\b/gi, 'Makam Besar Bawah Tanah Nazarick')\r\n168:     .replace(/\\bPenguasa Tertinggi\\b/gi, 'Absolute Overlord')\r\n169:     .replace(/\\bRaja Sihir\\b/gi, 'Sorcerer King')\r\n170:     .replace(/\\bKerajaan Sihir\\b/gi, 'Sorcerer Kingdom');\r\n171: }\r\n172: \r\n173: function extractEpubChapters(epubPath: string): Chapter[] {\r\n174:   console.log('📦 Membaca isi file EPUB...');\r\n175:   const baseName = path.basename(epubPath, path.extname(epubPath));\r\n176:   const dirName = path.dirname(epubPath);\r\n177:   const tempDir = path.join(dirName, '.temp_epub_extract');\r\n178:   if (fs.existsSync(tempDir)) fs.rmSync(tempDir, { recursive: true, force: true });\r\n179:   fs.mkdirSync(tempDir, { recursive: true });\r\n180: \r\n181:   try {\r\n182:     execSync(`tar -xf \"${epubPath}\" -C \"${tempDir}\"`, { stdio: 'pipe' });\r\n183:   } catch (err) {\r\n184:     throw new Error('Gagal mengekstrak EPUB: ' + err);\r\n185:   }\r\n186: \r\n187:   // Simpan gambar ke folder illustrations/<baseName>\r\n188:   const illustDir = path.join(dirName, 'illustrations', baseName);\r\n189:   if (!fs.existsSync(illustDir)) fs.mkdirSync(illustDir, { recursive: true });\r\n190: \r\n191:   function copyImages(dir: string) {\r\n192:     for (const ent of fs.readdirSync(dir, { withFileTypes: true })) {\r\n193:       const full = path.join(dir, ent.name);\r\n194:       if (ent.isDirectory()) copyImages(full);\r\n195:       else if (/\\.(jpe?g|png|webp|gif)$/i.test(ent.name)) {\r\n196:         fs.copyFileSync(full, path.join(illustDir, ent.name));\r\n197:       }\r\n198:     }\r\n199:   }\r\n200:   copyImages(tempDir);\r\n201: \r\n202:   // Cari berkas OPF untuk membaca urutan canonical spine\r\n203:   function findOpf(dir: string): string | null {\r\n204:     for (const ent of fs.readdirSync(dir, { withFileTypes: true })) {\r\n205:       const full = path.join(dir, ent.name);\r\n206:       if (ent.isDirectory()) {\r\n207:         const res = findOpf(full);\r\n208:         if (res) return res;\r\n209:       } else if (ent.name.endsWith('.opf')) {\r\n210:         return full;\r\n211:       }\r\n212:     }\r\n213:     return null;\r\n214:   }\r\n215: \r\n216:   const opfFile = findOpf(tempDir);\r\n217:   const spineHrefs: string[] = [];\r\n218:   let opfDir = tempDir;\r\n219: \r\n220:   if (opfFile) {\r\n221:     opfDir = path.dirname(opfFile);\r\n222:     const opfXml = fs.readFileSync(opfFile, 'utf-8');\r\n223:     const manifest: Record<string, string> = {};\r\n224:     for (const itemTag of opfXml.match(/<item\\b[^>]*>/gi) || []) {\r\n225:       const idM = itemTag.match(/\\bid=[\"']([^\"']+)[\"']/i);\r\n226:       const hrefM = itemTag.match(/\\bhref=[\"']([^\"']+)[\"']/i);\r\n227:       if (idM && hrefM) {\r\n228:         manifest[idM[1]] = hrefM[1];\r\n229:       }\r\n230:     }\r\n231:     const itemrefs = [...opfXml.matchAll(/<itemref\\b[^>]*\\bidref=[\"']([^\"']+)[\"']/gi)].map(m => m[1]);\r\n232:     for (const idref of itemrefs) {\r\n233:       if (manifest[idref]) spineHrefs.push(manifest[idref]);\r\n234:     }\r\n235:   }\r\n236: \r\n237:   const targetFiles: string[] = spineHrefs.length > 0 \r\n238:     ? spineHrefs.map(href => path.resolve(opfDir, href))\r\n239:     : [];\r\n240: \r\n241:   if (targetFiles.length === 0) {\r\n242:     function scanDir(dir: string) {\r\n243:       for (const ent of fs.readdirSync(dir, { withFileTypes: true })) {\r\n244:         const full = path.join(dir, ent.name);\r\n245:         if (ent.isDirectory()) scanDir(full);\r\n246:         else if (/\\.(html|xhtml)$/i.test(ent.name)) targetFiles.push(full);\r\n247:       }\r\n248:     }\r\n249:     scanDir(tempDir);\r\n250:     targetFiles.sort((a, b) => a.localeCompare(b, undefined, { numeric: true }));\r"}
