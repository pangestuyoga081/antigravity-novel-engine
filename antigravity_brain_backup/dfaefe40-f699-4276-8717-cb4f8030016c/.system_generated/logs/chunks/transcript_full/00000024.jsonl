argetFile).toLowerCase();\n647:   const baseName = path.basename(targetFile, ext);\n648:   const dirName = path.dirname(targetFile);\n649: \n650:   const outputFile = path.join(dirName, `${baseName} (Terjemahan ID-Direct).txt`);\n651:   const checkpointFile = path.join(dirName, `${baseName}_checkpoint.json`);\n652:   const cacheDir = path.join(dirName, `.${baseName}_chunks_cache`);\n653: \n654:   const isKonosuba = /konosuba|kono\\s*subarashii/i.test(targetFile);\n655:   const isWarhammer = /horus|warhammer|astartes|dan\\s*abnett/i.test(targetFile);\n656:   const styleMode: 'konosuba' | 'warhammer' | 'default' = isKonosuba ? 'konosuba' : (isWarhammer ? 'warhammer' : 'default');\n657: \n658:   if (!fs.existsSync(cacheDir)) {\n659:     fs.mkdirSync(cacheDir, { recursive: true });\n660:   }\n661: \n662:   console.log(`\\n📁 File Input   : ${targetFile}`);\n663:   console.log(`📄 File Output  : ${outputFile}`);\n664:   console.log(`🔖 Checkpoint   : ${checkpointFile}`);\n665:   console.log(`📂 Chunk Cache  : ${cacheDir}`);\n666:   console.log(`⚡ Concurrency  : ${CONFIG.concurrency} Workers | Model: ${CONFIG.model}`);\n667:   \n668:   let styleDesc = 'Laga Aksi Luwes (Tell-Don\\'t-Show, To-The-Point)';\n669:   if (styleMode === 'warhammer') styleDesc = 'Sci-Fi Militer Grimdark Warhammer 40k (Badass, Tell-Don\\'t-Show, Taktis & Gaul Prajurit)';\n670:   if (styleMode === 'konosuba') styleDesc = 'Light Novel Komedi Isekai (Tell-Don\\'t-Show, Manga Pacing, Gaul)';\n671:   console.log(`🎨 Style Mode   : ${styleDesc}\\n`);\n672: \n673:   let chapters: Chapter[] = [];\n674:   if (ext === '.epub') {\n675:     chapters = extractEpubChapters(targetFile);\n676:   } else if (ext === '.txt') {\n677:     chapters = extractTxtChapters(targetFile);\n678:   } else {\n679:     console.error('❌ Format file tidak didukung! Harap masukkan file .epub atau .txt');\n680:     process.exit(1);\n681:   }\n682: \n683:   console.log(`✅ Berhasil mendeteksi ${chapters.length} Bab dari file.\\n`);\n684: \n685:   let checkpoint = { completedIds: [] as string[] };\n686:   if (fs.existsSync(checkpointFile)) {\n687:     try {\n688:       checkpoint = JSON.parse(fs.readFileSync(checkpointFile, 'utf-8'));\n689:     } catch {}\n690:   }\n691: \n692:   for (let i = 0; i < chapters.length; i++) {\n693:     const ch = chapters[i];\n694: \n695:     if (checkpoint.completedIds.includes(ch.id)) {\n696:       console.log(`⏭️  [${i + 1}/${chapters.length}] Lewati: ${ch.title} (Sudah selesai)`);\n697:       continue;\n698:     }\n699: \n700:     console.log(`----------------------------------------------------------------`);\n701:     console.log(`📖 [${i + 1}/${chapters.length}] Memproses: ${ch.title} (~${ch.text.length} karakter)`);\n702:     console.log(`----------------------------------------------------------------`);\n703: \n704:     const chapCacheDir = path.join(cacheDir, ch.id);\n705:     if (!fs.existsSync(chapCacheDir)) {\n706:       fs.mkdirSync(chapCacheDir, { recursive: true });\n707:     }\n708: \n709:     const chunks = splitParagraphSafe(ch.text, CONFIG.maxChunkChars);\n710:     console.log(`📦 Dibagi menjadi ${chunks.length} bagian chunk...`);\n711: \n712:     const startT = Date.now();\n713:     const translatedParts = await mapConcurrent(chunks, CONFIG.concurrency, async (chunkText, idx) => {\n714:       const chunkFile = path.join(chapCacheDir, `chunk_${String(idx + 1).padStart(3, '0')}.txt`);\n715: \n716:       if (fs.existsSync(chunkFile)) {\n717:         const cached = fs.readFileSync(chunkFile, 'utf-8');\n718:         if (!isRefusalResponse(cached) && cached.length > 50) {\n719:           console.log(`   ⚡ Bagian [${idx + 1}/${chunks.length}] dimuat dari cache lokal.`);\n720:           return cached;\n721:         } else {\n722:           fs.rmSync(chunkFile, { force: true });\n723:         }\n724:       }\n725: \n726:       const prevContext = idx > 0 ? chunks[idx - 1] : null;\n727:       const tStart = Date.now();\n728:       const res = await callLLM(chunkT