}\n    )\n    with urllib.request.urlopen(req, timeout=30) as resp:\n        res = json.loads(resp.read().decode(\"utf-8\"))\n        dur = time.time() - t0\n        return f\"Req {i} ({dur:.1f}s): {res['choices'][0]['message']['content'].strip()}\"\n\nt_start = time.time()\nwith ThreadPoolExecutor(max_workers=3) as executor:\n    results = list(executor.map(send_req, range(3)))\n\nprint(f\"Total time for 3 concurrent: {time.time() - t_start:.1f}s\")\nfor r in results:\n    print(\" \", r)\n","Path":"C:\\Users\\Eevyx\\.gemini\\antigravity\\brain\\dfaefe40-f699-4276-8717-cb4f8030016c\\scratch\\test_concurrency.py"}}]}
