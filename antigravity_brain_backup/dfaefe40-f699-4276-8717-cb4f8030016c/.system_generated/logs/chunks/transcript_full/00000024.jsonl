{"step_index":1626,"source":"MODEL","type":"GENERIC","status":"DONE","created_at":"2026-11-13T07:45:16Z","content":"Created At: 2026-11-13T14:45:16+07:00\nCompleted At: 2026-11-13T14:45:16+07:00\nShowing lines 451-600 of 756\n451: \n452:   if (chapters.length === 0) {\n453:     return [{ id: 'full_text', title: path.basename(txtPath), text: cleanWatermarks(content) }];\n454:   }\n455: \n456:   return chapters;\n457: }\n458: \n459: function splitParagraphSafe(text: string, maxChars: number): string[] {\n460:   const paragraphs = text.split('\\n');\n461:   const chunks: string[] = [];\n462:   let current: string[] = [];\n463:   let len = 0;\n464: \n465:   for (const p of paragraphs) {\n466:     current.push(p);\n467:     len += p.length + 1;\n468:     if (len >= maxChars) {\n469:       chunks.push(current.join('\\n'));\n470:       current = [];\n471:       len = 0;\n472:     }\n473:   }\n474: \n475:   if (current.length > 0) chunks.push(current.join('\\n'));\n476:   return chunks;\n477: }\n478: \n479: function buildPrompt(text: string, styleMode: 'konosuba' | 'warhammer' | 'default'): string {\n480:   const explanationRule = `- Penjelasan Istilah Asing / Teknis / Lore Cerita:\n481:   Setiap istilah asing, istilah teknis, atau konsep yang berpotensi tidak dipahami pembaca dalam narasi maupun dialog harus disertai penjelasan singkat dalam bahasa Indonesia dengan format konsisten: Istilah (arti atau penjelasan sederhana). Contoh: Vox (perangkat komunikasi radio militer), Remembrancer (sejarawan/pencatat resmi ekspedisi), Browser (peramban web untuk menjelajahi internet).\n482:   Terapkan secara alami sesuai konteks cerita, tanpa merusak alur, suasana, atau dialog karakter. Jelaskan hanya istilah yang benar-benar berpotensi membingungkan, utamakan saat pertama kali muncul, dan hindari pengulangan penjelasan yang sama. Gunakan bahasa sehari-hari yang lugas, bukan penjelasan formal seperti kamus. Jika istilah memiliki makna khusus dalam dunia cerita, jelaskan berdasarkan konteks tersebut.`;\n483: \n484:   if (styleMode === 'warhammer') {\n485:     return `Tuliskan seluruh cerita dalam Bahasa Indonesia yang lugas, energik, badass, dan to-the-point — setara dengan komik/manga terjemahan resmi, webtoon aksi sci-fi militer, atau novel aksi grimdark populer. Target pembaca adalah remaja/young-adult: ritme cepat, intens, maskulin/taktis, adiktif, dan langsung pada pokok masalah. Jangan kaku seperti terjemahan mesin, dan jangan gunakan bahasa formal makalah (\"Anda\", \"mengindikasikan\", \"beliau\"). Format dialog konsisten sertakan Nama: \"...\".\n486: \n487: Aturan Mutlak:\n488: - Tell, Don't Show (Lugas & Transparan). Pangkas deskripsi fisiologis mikro yang kepanjangan (butiran keringat, tarikan napas mikro, urat nadi). Langsung sampaikan situasi taktis, atmosfer perang, dan isi pikiran karakter secara tegas.\n489: - Nol Metafora & Anti-Puitis. Dilarang keras menggunakan analogi filosofis lebay atau kalimat bunga-bunga. Pertempuran dan ketegangan disampaikan secara konkret dan berbobot.\n490: - Slang & Dialog Prajurit (lu-gue/lo-gue antar saudara seperjuangan Space Marine akrab, sapaan \"saudara\", \"kapten\", \"sobat\"; santai to-the-point dengan sesama manusia/remembrancer).\n491: - Pacing Cepat ala Panel Manga: aksi taktis langsung → reaksi singkat → dialog balasan.\n492: - Istilah Asli (Loanwords): Pertahankan istilah asli semesta Warhammer 40k (Primarch, Warmaster, Astartes, Space Marines, Legion, Luna Wolves, Mournival, Remembrancer, Iterator, Bolter, Chainsword, Dreadnought, Drop-pod, Warp, Ceramite, Pict, Vox).\n493: ${explanationRule}\n494: \n495: Naskah Mentah:\\n\\n${text}`;\n496:   }\n497: \n498:   if (styleMode === 'konosuba') {\n499:     return `Tuliskan seluruh cerita dalam Bahasa Indonesia yang luwes, hidup, dan to-the-point — setara dengan komik/manga terjemahan resmi, webtoon aksi, atau light novel populer. Target pembaca adalah remaja/young-adult: ritme cepat, energik, kocak, padat, adiktif, dan langsung pada pokok masalah. Jangan kaku seperti terjemahan mesin, dan jangan gunakan bahasa formal makalah (\"Anda\", \"mengindikasikan\", \"beliau\"). Format dialog konsisten sertakan Nama: \"...\".\n500: \n501: Aturan Mutlak:\n502: - Tell, Don't Show (Lugas & Transparan). Pangkas deskripsi fisiologis mikro yang kepanjangan (butiran keringat, tarikan napas mikro, urat nadi). Langsung beri tahu fakta, situasi, dan isi pikiran karakter secara tegas.\n503: - Nol Metafora & Anti-Puitis. Dilarang keras menggunakan kalimat berbunga-bunga atau analogi filosofis lebay.\n504: - Slang & Bahasa Santai (lu-gue/kamu-aku sesuai relasi). Karakter bicara natural seperti manusia hidup di eranya.\n505: - Pacing Cepat ala Panel Komik / Manga: aksi langsung → reaksi singkat → dialog balasan.\n506: - Istilah Asli (Loanwords): Pertahankan istilah asli (nama jurus/sihir seperti Explosion, Steal; honorifik -san, -kun, senpai; nama monster/faksi).\n507: ${explanationRule}\n508: \n509: Naskah Mentah:\\n\\n${text}`;\n510:   }\n511: \n512:   return `Tuliskan seluruh cerita dalam Bahasa Indonesia yang luwes, hidup, dan to-the-point — setara dengan komik/manga terjemahan resmi, webtoon aksi, atau novel laga populer. Target pembaca adalah remaja/young-adult: ritme cepat, energik, padat, adiktif, dan langsung pada pokok masalah. Jangan kaku seperti terjemahan mesin, dan jangan gunakan bahasa formal makalah (\"Anda\", \"mengindikasikan\", \"beliau\"). Format dialog konsisten sertakan Nama: \"...\". Tell, don't show, nol metafora lebay, pertahankan istilah asli.\n513: ${explanationRule}\n514: \n515: Naskah mentah:\\n\\n${text}`;\n516: }\n517: \n518: async function callLLMSingle(text: string, styleMode: 'konosuba' | 'warhammer' | 'default', sanitize = false): Promise<string> {\n519:   const parsedUrl = new URL(CONFIG.proxyUrl);\n520:   let processedText = cleanWatermarks(text);\n521:   if (sanitize || styleMode === 'konosuba') {\n522:     processedText = sanitizeSensitiveWords(processedText);\n523:   }\n524: \n525:   const promptContent = buildPrompt(processedText, styleMode);\n526: \n527:   const payload = JSON.stringify({\n528:     model: CONFIG.model,\n529:     messages: [\n530:       { role: 'user', content: promptContent }\n531:     ],\n532:     temperature: styleMode === 'konosuba' ? 0.7 : 0.6,\n533:     stream: false\n534:   });\n535: \n536:   const rawResponse = await new Promise<string>((resolve, reject) => {\n537:     const req = http.request({\n538:       hostname: parsedUrl.hostname,\n539:       port: parsedUrl.port || 80,\n540:       path: parsedUrl.pathname,\n541:       method: 'POST',\n542:       headers: {\n543:         'Content-Type': 'application/json',\n544:         'Authorization': `Bearer ${CONFIG.apiKey}`,\n545:         'Content-Length': Buffer.byteLength(payload)\n546:       },\n547:       timeout: 180000\n548:     }, (res) => {\n549:       let d = '';\n550:       res.on('data', c => d += c);\n551:       res.on('end', () => {\n552:         if (res.statusCode && res.statusCode >= 200 && res.statusCode < 300) {\n553:           resolve(d);\n554:         } else {\n555:           reject(new Error(`HTTP ${res.statusCode}: ${d}`));\n556:         }\n557:       });\n558:     });\n559:     req.on('error', reject);\n560:     req.on('timeout', () => req.destroy(new Error('Request Timeout')));\n561:     req.write(payload);\n562:     req.end();\n563:   });\n564: \n565:   return parseSSEorJSON(rawResponse);\n566: }\n567: \n568: async function callLLM(text: string, prevContext: string | null, styleMode: 'konosuba' | 'warhammer' | 'default', retry = 3): Promise<string> {\n569:   for (let attempt = 1; attempt <= retry; attempt++) {\n570:     try {\n571:       const needSanitize = attempt > 1;\n572:       const res = await callLLMSingle(text, styleMode, needSanitize);\n573: \n574:       if (!isRefusalResponse(res) && res.length >= 50) {\n575:         return res;\n576:       }\n577: \n578:       console.warn(`   ⚠️ [Percobaan ${attempt}] Output ditolak filter (${res.length} chars). Menerapkan strategi pemecahan sub-chunk & sanitasi...`);\n579:     } catch (err: any) {\n580:       console.warn(`   ⚠️ [Percobaan ${attempt}] Error: ${err.message}`);\n581:     }\n582: \n583:     if (text.length > 2000) {\n584:       const lines = text.split('\\n');\n585:       const mid = Math.floor(lines.length / 2);\n586:       const part1 = lines.slice(0, mid).join('\\n').trim();\n587:       const part2 = lines.slice(mid).join('\\n').trim();\n588: \n589:       if (part1 && part2) {\n590:         console.log(`   ✂️ Membagi chunk bermasalah menjadi 2 sub-bagian (${part1.length} chars & ${part2.length} chars)...`);\n591:         try {\n592:           const res1 = await callLLMSingle(part1, styleMode, true);\n593:           const res2 = await callLLMSingle(part2, styleMode, true);\n594:           if (res1.length >= 50 && res2.length >= 50 && !isRefusalResponse(res1) && !isRefusalResponse(res2)) {\n595:             return `${res1}\\n\\n${res2}`;\n596:           }\n597:         } catch (subErr) {\n598:           console.warn(`   ⚠️ Sub-chunk split juga mengalami kendala, mencoba ulang...`);\n599:         }\n600:       }"}
