{"step_index":484,"source":"MODEL","type":"PLANNER_RESPONSE","status":"DONE","created_at":"2026-11-12T01:28:49Z","input_tokens":3187,"cache_read_tokens":238174,"output_tokens":539,"tool_calls":[{"name":"edit_file","args":{"Path":"D:\\JV\\novel yoga\\translate-novel-dragndrop.ts","Replacement":"async function translateTitle(rawTitle: string): Promise<string> {\n  const cleanTitle = rawTitle.replace(/^#+\\s*/, '').trim();\n  if (/^PROLOG/i.test(cleanTitle)) return 'PROLOG';\n  if (/^EPILOG/i.test(cleanTitle)) return 'EPILOG';\n\n  try {\n    const parsedUrl = new URL(CONFIG.proxyUrl);\n    const payload = JSON.stringify({\n      model: CONFIG.model,\n      messages: [\n        { role: 'user', content: `Terjemahkan judul bab berikut ke Bahasa Indonesia to-the-point dan singkat tanpa tanda kutip:\\n\\n${cleanTitle}` }\n      ],\n      temperature: 0.3,\n      stream: false\n    });\n\n    const resText = await new Promise<string>((resolve, reject) => {\n      const req = http.request({\n        hostname: parsedUrl.hostname,\n        port: parsedUrl.port || 80,\n        path: parsedUrl.pathname,\n        method: 'POST',\n        headers: {\n          'Content-Type': 'application/json',\n          'Authorization': `Bearer ${CONFIG.apiKey}`,\n          'Content-Length': Buffer.byteLength(payload)\n        },\n        timeout: 30000\n      }, (res) => {\n        let d = '';\n        res.on('data', c => d += c);\n        res.on('end', () => {\n          try {\n            const j = JSON.parse(d);\n            resolve(j.choices?.[0]?.message?.content?.trim() || cleanTitle);\n          } catch {\n            resolve(cleanTitle);\n          }\n        });\n      });\n      req.on('error', () => resolve(cleanTitle));\n      req.on('timeout', () => {\n        req.destroy();\n        resolve(cleanTitle);\n      });\n      req.write(payload);\n      req.end();\n    });\n\n    return resText.replace(/[\"']/g, '').trim() || cleanTitle;\n  } catch {\n    return cleanTitle;\n  }\n}\n\nasync function main() {","Target":"async function main() {"}}]}
