{"step_index":3206,"source":"MODEL","type":"PLANNER_RESPONSE","status":"DONE","created_at":"2026-11-19T03:45:43Z","input_tokens":2344,"cache_read_tokens":212195,"output_tokens":2047,"tool_calls":[{"name":"run_command","args":{"CommandLine":"python -c \"\nimport os, sys, re, zipfile, html\n\ntxt_file = r'D:\\JV\\novel yoga\\Tom Clancy - 09. Rainbow six - vol. 1+2 (Terjemahan ID-Direct).txt'\nout_epub = r'D:\\JV\\novel yoga\\epubs\\Tom Clancy - Rainbow Six (Vol 1+2) (Illustrated ID-Direct).epub'\n\nwith open(txt_file, 'r', encoding='utf-8') as f:\n    full_text = f.read()\n\nsections = re.split(r'(?=^###\\s+)', full_text, flags=re.MULTILINE)\nchapters = []\nfor s in sections:\n    s = s.strip()\n    if not s.startswith('###'): continue\n    lines = s.split('\\n')\n    title = re.sub(r'^([=*\\s]+)', '', lines[0].replace('###', '').strip()).strip()\n    body = '\\n'.join(lines[1:]).strip()\n    body = re.sub(r'^={10,}\\s*$', '', body, flags=re.MULTILINE)\n    if len(body) > 100: chapters.append({'title': title, 'body': body})\n\ndef text_to_html(body_text):\n    paragraphs = body_text.split('\\n')\n    html_parts = []\n    for p in paragraphs:\n        p = p.strip()\n        if not p: continue\n        spk_match = re.match(r'^([^:]+?):\\s*\\\"(.*)\\\"$', p)\n        if spk_match:\n            spk = html.escape(spk_match.group(1))\n            dial = html.escape(spk_match.group(2))\n            html_parts.append(f'<p class=\\\"dialogue\\\"><span class=\\\"speaker\\\">{spk}:</span> &#8220;{dial}&#8221;</p>')\n            continue\n        esc_p = html.escape(p)\n        esc_p = re.sub(r'\\*\\*(.*?)\\*\\*', r'<strong>\\1</strong>', esc_p)\n        esc_p = re.sub(r'\\*(.*?)\\*', r'<em>\\1</em>', esc_p)\n        html_parts.append(f'<p>{esc_p}</p>')\n    return '\\n'.join(html_parts)\n\nCSS_CONTENT = '''@charset \\\"utf-8\\\";\nbody { margin: 5% 8%; font-family: sans-serif; line-height: 1.8; color: #2b2b2b; text-align: justify; }\nh1 { text-align: center; color: #1a1a1a; margin-top: 1.5em; margin-bottom: 1em; }\np { margin: 0.8em 0; text-indent: 1.5em; }\np.dialogue { text-indent: 0; margin-left: 0.5em; font-weight: 500; }\n.speaker { font-weight: 700; color: #8b3a00; }'''\n\nwith zipfile.ZipFile(out_epub, 'w', compression=zipfile.ZIP_DEFLATED) as z:\n    z.writestr('mimetype', 'application/epub+zip', compress_type=zipfile.ZIP_STORED)\n    container_xml = '''<?xml version=\\\"1.0\\\" encoding=\\\"UTF-8\\\"?>\n<container version=\\\"1.0\\\" xmlns=\\\"urn:oasis:names:tc:opendocument:xmlns:container\\\">\n    <rootfiles><rootfile full-path=\\\"OEBPS/content.opf\\\" media-type=\\\"application/oebps-package+xml\\\"/></rootfiles>\n</container>'''\n    z.writestr('META-INF/container.xml', container_xml)\n    z.writestr('OEBPS/css/stylesheet.css', CSS_CONTENT)\n\n    manifest_items = []\n    spine_items = []\n    toc_ncx_items = []\n    nav_html_items = []\n\n    for idx, ch in enumerate(chapters, start=1):\n        filename = f'chapter_{idx:03d}.xhtml'\n        cid = f'chap_{idx:03d}'\n        ch_title = html.escape(ch['title'])\n        body_html = text_to_html(ch['body'])\n        content = f'''<?xml version=\\\"1.0\\\" encoding=\\\"utf-8\\\"?>\n<!DOCTYPE html>\n<html xmlns=\\\"http://www.w3.org/1999/xhtml\\\" xmlns:epub=\\\"http://www.idpf.org/2007/ops\\\">\n<head><title>{ch_title}</title><link rel=\\\"stylesheet\\\" type=\\\"text/css\\\" href=\\\"css/stylesheet.css\\\"/></head>\n<body><h1>{ch_title}</h1>{body_html}</body></html>'''\n        z.writestr(f'OEBPS/{filename}', content)\n        manifest_items.append(f'<item id=\\\"{cid}\\\" href=\\\"{filename}\\\" media-type=\\\"application/xhtml+xml\\\"/>\\n')\n        spine_items.append(f'<itemref idref=\\\"{cid}\\\"/>\\n')\n        toc_ncx_items.append(f'<navPoint id=\\\"nav_{cid}\\\" playOrder=\\\"{idx}\\\"><navLabel><text>{ch_title}</text></navLabel><content src=\\\"{filename}\\\"/></navPoint>\\n')\n        nav_html_items.append(f'<li><a href=\\\"{filename}\\\">{ch_title}</a></li>\\n')\n\n    book_title = 'Tom Clancy: Rainbow Six (Vol. 1+2)'\n    book_uid = 'urn:uuid:tom-clancy-rainbow-six-vol-1-2'\n    toc_ncx = f'''<?xml version=\\\"1.0\\\" encoding=\\\"UTF-8\\\"?>\n<ncx xmlns=\\\"http://www.daisy.org/z3986/2005/ncx/\\\" version=\\\"2005-1\\\">\n    <head><meta name=\\\"dtb:uid\\\" content=\\\"{book_uid}\\\"/><meta name=\\\"dtb:depth\\\" content=\\\"1\\\"/><meta name=\\\"dtb:totalPageCount\\\" content=\\\"0\\\"/><meta name=\\\"dtb:maxPageNumber\\\" content=\\\"0\\\"/></head>\n    <docTitle><text>{book_title}</text></docTitle>\n    <navMap>{\\\"\\\".join(toc_ncx_items)}</navMap></ncx>'''\n    z.writestr('OEBPS/toc.ncx', toc_ncx)\n    nav_xhtml = f'''<?xml version=\\\"1.0\\\" encoding=\\\"utf-8\\\"?>\n<!DOCTYPE html>\n<html xmlns=\\\"http://www.w3.org/1999/xhtml\\\" xmlns:epub=\\\"http://www.idpf.org/2007/ops\\\"><head><title>Daftar Isi</title><link rel=\\\"stylesheet\\\" type=\\\"text/css\\\" href=\\\"css/stylesheet.css\\\"/></head>\n<body><nav epub:type=\\\"toc\\\" id=\\\"toc\\\"><h1>Daftar Isi</h1><ol>{\\\"\\\".join(nav_html_items)}</ol></nav></body></html>'''\n    z.writestr('OEBPS/nav.xhtml', nav_xhtml)\n    content_opf = f'''<?xml version=\\\"1.0\\\" encoding=\\\"UTF-8\\\"?>\n<package xmlns=\\\"http://www.idpf.org/2007/opf\\\" unique-identifier=\\\"BookID\\\" version=\\\"3.0\\\">\n    <metadata xmlns:dc=\\\"http://purl.org/dc/elements/1.1/\\\">\n        <dc:title>{book_title}</dc:title><dc:creator>Tom Clancy</dc:creator><dc:language>id</dc:language><dc:identifier id=\\\"BookID\\\">{book_uid}</dc:identifier>\n    </metadata>\n    <manifest><item id=\\\"ncx\\\" href=\\\"toc.ncx\\\" media-type=\\\"application/x-dtbncx+xml\\\"/><item id=\\\"nav\\\" href=\\\"nav.xhtml\\\" media-type=\\\"application/xhtml+xml\\\" properties=\\\"nav\\\"/><item id=\\\"css\\\" href=\\\"css/stylesheet.css\\\" media-type=\\\"text/css\\\"/>{\\\"\\\".join(manifest_items)}</manifest>\n    <spine toc=\\\"ncx\\\">{\\\"\\\".join(spine_items)}</spine></package>'''\n    z.writestr('OEBPS/content.opf', content_opf)\n\nprint('Rainbow Six EPUB fixed successfully!')\n\"","WaitMsBeforeAsync":15000,"toolSummary":"Recompile Rainbow Six with numeric entity"}}]}
