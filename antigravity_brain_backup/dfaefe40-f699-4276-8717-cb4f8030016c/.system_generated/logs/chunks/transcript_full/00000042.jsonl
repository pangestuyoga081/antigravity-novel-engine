title}</a></li>\\n')\n\n    book_title = \"Tom Clancy: Rainbow Six (Vol. 1+2)\"\n    book_uid = \"urn:uuid:tom-clancy-rainbow-six-vol-1-2\"\n    toc_ncx = f\"\"\"<?xml version=\"1.0\" encoding=\"UTF-8\"?>\n<ncx xmlns=\"http://www.daisy.org/z3986/2005/ncx/\" version=\"2005-1\">\n    <head><meta name=\"dtb:uid\" content=\"{book_uid}\"/><meta name=\"dtb:depth\" content=\"1\"/><meta name=\"dtb:totalPageCount\" content=\"0\"/><meta name=\"dtb:maxPageNumber\" content=\"0\"/></head>\n    <docTitle><text>{book_title}</text></docTitle>\n    <navMap>{\"\".join(toc_ncx_items)}</navMap></ncx>\"\"\"\n    z.writestr(\"OEBPS/toc.ncx\", toc_ncx)\n    nav_xhtml = f\"\"\"<?xml version=\"1.0\" encoding=\"utf-8\"?>\n<!DOCTYPE html>\n<html xmlns=\"http://www.w3.org/1999/xhtml\" xmlns:epub=\"http://www.idpf.org/2007/ops\"><head><title>Daftar Isi</title><link rel=\"stylesheet\" type=\"text/css\" href=\"css/stylesheet.css\"/></head>\n<body><nav epub:type=\"toc\" id=\"toc\"><h1>Daftar Isi</h1><ol>{\"\".join(nav_html_items)}</ol></nav></body></html>\"\"\"\n    z.writestr(\"OEBPS/nav.xhtml\", nav_xhtml)\n    content_opf = f\"\"\"<?xml version=\"1.0\" encoding=\"UTF-8\"?>\n<package xmlns=\"http://www.idpf.org/2007/opf\" unique-identifier=\"BookID\" version=\"3.0\">\n    <metadata xmlns:dc=\"http://purl.org/dc/elements/1.1/\">\n        <dc:title>{book_title}</dc:title><dc:creator>Tom Clancy</dc:creator><dc:language>id</dc:language><dc:identifier id=\"BookID\">{book_uid}</dc:identifier>\n    </metadata>\n    <manifest><item id=\"ncx\" href=\"toc.ncx\" media-type=\"application/x-dtbncx+xml\"/><item id=\"nav\" href=\"nav.xhtml\" media-type=\"application/xhtml+xml\" properties=\"nav\"/><item id=\"css\" href=\"css/stylesheet.css\" media-type=\"text/css\"/>{\"\".join(manifest_items)}</manifest>\n    <spine toc=\"ncx\">{\"\".join(spine_items)}</spine></package>\"\"\"\n    z.writestr(\"OEBPS/content.opf\", content_opf)\n\nprint(\"Rainbow Six EPUB fixed successfully!\")\n","Path":"D:/JV/novel yoga/fix_r