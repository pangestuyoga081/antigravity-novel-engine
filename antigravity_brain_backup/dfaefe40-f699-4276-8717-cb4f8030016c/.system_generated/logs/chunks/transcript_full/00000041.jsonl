nimport re\n\nepub_path = r\"D:\\JV\\novel yoga\\Fifty_Shades_of_Grey_-_E_L_James.epub\"\n\nwith zipfile.ZipFile(epub_path, 'r') as z:\n    for hf in [\"index_split_000.html\", \"index_split_017.html\", \"index_split_018.html\", \"index_split_019.html\"]:\n        raw = z.read(hf).decode('utf-8', errors='ignore')\n        # Cari angka berdiri sendiri di baris baru atau paragraf khusus\n        calibre_classes = re.findall(r'<p class=\"([^\"]+)\">([^<]{1,30})</p>', raw)\n        print(f\"=== {hf} sample short paragraphs ===\")\n        for c, text in calibre_classes[:25]:\n            t = text.strip()\n            if t and (t.isdigit() or len(t) < 15):\n                print(f\"class={c} | text={t}\")\n","Path":"D:/JV/novel yoga/find_calibre_classes.py"}}]}
