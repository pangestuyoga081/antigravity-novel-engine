arn(`   ⚠️ Error saat memproses teks utuh: ${err.message}`);\n1081:     await handleCooldown(err, 1);\n1082:   }\n1083: \n1084:   // 2. Pemecahan adaptif bertingkat: coba ukuran 1800 -> 1100 -> 700 -> 500 chars\n1085:   const targetSizes = [1800, 1100, 700, 500];\n1086: \n1087:   for (const targetSize of targetSizes) {\n1088:     const subChunks = splitTextIntoParts(text, targetSize);\n1089:     console.log(`   ✂️ Membagi chunk bermasalah menjadi ${subChunks.length} sub-bagian (~${targetSize} chars)...`);\n1090: \n1091:     const subResults: string[] = [];\n1092:     let allOk = true;\n1093: \n1094:     for (let i = 0; i < subChunks.length; i++) {\n1095:       const sub = subChunks[i];\n1096:       let subSuccess = false;\n1097: \n1098:       // Beri 3 kali kesempatan untuk sub-bagian ini secara mandiri\n1099:       for (let subAttempt = 1; subAttempt <= 3; subAttempt++) {\n1100:         try {\n1101:           if (i > 0) await new Promise(r => setTimeout(r, 600));\n1102: \n1103:           const subRes = await callLLMSingle(sub, styleMode, subAttempt > 1, subAttempt > 1);\n1104:           if (!isRefusalResponse(subRes) && subRes.length >= 30) {\n1105:             subResults.push(subRes);\n1106:             subSuccess = true;\n1107:             break;\n1108:           }\n1109:           console.warn(`   ⚠️ Sub-bagian [${i + 1}/${subChunks.length}] tertolak filter (${subRes.length} chars). Mencoba ulang sub-bagian ini...`);\n1110:         } catch (subErr: any) {\n1111:           console.warn(`   ⚠️ Error pada sub-bagian [${i + 1}/${subChunks.length}]: ${subErr.message}`);\n1112:           await handleCooldown(subErr, subAttempt);\n1113:         }\n1114:       }\n1115: \n1116:       if (!subSuccess) {\n1117:         allOk = false;\n1118:         console.warn(`   ⚠️ Sub-bagian [${i + 1}/${subChunks.length}] gagal pada level ${targetSize} chars. Beralih ke pecahan lebih kecil...`);\n1119:         break;\n1120:       }"}
