ngindikasikan\", \"beliau\"). Format dialog konsisten sertakan Nama: \"...\". Tell, don't show, nol metafora lebay, pertahankan istilah asli.\n964: ${explanationRule}\n965: \n966: Naskah mentah:\\n\\n${text}`;\n967: }\n968: \n969: async function callLLMSingle(text: string, styleMode: StyleMode, sanitize = false, simplified = false): Promise<string> {\n970:   const parsedUrl = new URL(CONFIG.proxyUrl);\n971:   let processedText = cleanWatermarks(text);\n972:   if (sanitize || styleMode === 'konosuba' || styleMode === 'overlord') {\n973:     processedText = sanitizeSensitiveWords(processedText);\n974:     processedText = maskCopyrightTokens(processedText);\n975:   }\n976: \n977:   const promptContent = buildPrompt(processedText, styleMode, simplified);\n978: \n979:   const payload = JSON.stringify({\n980:     model: CONFIG.model,\n981:     messages: [\n982:       { role: 'user', content: promptContent }\n983:     ],\n984:     temperature: styleMode === 'konosuba' ? 0.7 : 0.6,\n985:     stream: false\n986:   });\n987: \n988:   const rawResponse = await new Promise<string>((resolve, reject) => {\n989:     const isHttps = parsedUrl.protocol === 'https:';\n990:     const client = isHttps ? https : http;\n991:     const req = client.request({\n992:       hostname: parsedUrl.hostname,\n993:       port: parsedUrl.port || (isHttps ? 443 : 80),\n994:       path: parsedUrl.pathname,\n995:       method: 'POST',\n996:       headers: {\n997:         'Content-Type': 'application/json',\n998:         'Authorization': `Bearer ${CONFIG.apiKey}`,\n999:         'Content-Length': Buffer.byteLength(payload)\n1000:       },\n1001:       timeout: 180000\n1002:     }, (res) => {\n1003:       let d = '';\n1004:       res.on('data', c => d += c);\n1005:       res.on('end', () => {\n1006:         if (res.statusCode && res.statusCode >= 200 && res.statusCode < 300) {\n1007:           resolve(d);\n1008:         } else {\n1009:           reject(new Error(`HTTP ${res.statusCode}: ${d}`));\n1010:         }\n1011:       });\n1012:     });\n1013:     req.on('error', reject);\n1014:     req.on('timeout', () => req.destroy(new Error('Request Timeout')));\n1015:     req.write(payload);\n1016:     req.end();\n1017:   });\n1018: \n1019:   const parsed = parseSSEorJSON(rawResponse);\n1020:   const cleaned = parsed"}
