n345:         curLines = [];\n346:         continue;\n347:       }\n348: \n349:       // Lewati daftar isi (TOC)\n350:       if (l.startsWith('#') || /^(List\\s+Chapter|Index|Attention|Warning!)/i.test(l)) {\n351:         continue;\n352:       }\n353: \n354:       // Filter nomor halaman tunggal\n355:       if (/^\\d+$/.test(l) && l.length < 5) {\n356:         continue;\n357:       }\n358: \n359:       // Deteksi awal bab riil\n360:       const isChap = /^(PROLOG(?:UE)?|EPILOG(?:UE)?|CHAPTER\\s+[0-9]+|INTERLUDE|SHORT\\s+STORY|EXTRA)/i.test(l);\n361:       if (isChap) {\n362:         const nextLines = lines.slice(i + 1, i + 8).map(x => x.trim()).filter(Boolean);\n363:         const isReal = nextLines.some(x => /^(Bagian\\s+[0-9]+|['\\\"“]|-)/i.test(x) || x.length > 30);\n364:         if (isReal) {\n365:           if (curChap && curLines.length > 50) {\n366:             curChap.text = cleanWatermarks(curLines.join('\\n').trim());\n367:             if (curChap.text.length > 400) chapters.push(curChap);\n368:           }\n369:           const chNum = String(chapters.length + 1).padStart(3, '0');\n370:           curChap = {\n371:             id: `${curVol.toLowerCase().replace(/[\\s.]+/g, '_')}_ch${chNum}`,\n372:             title: `${curVol} - ${l}`,\n373:             text: ''\n374:           };\n375:           curLines = [];\n376:           continue;\n377:         }\n378:       }\n379: \n380:       curLines.push(rawLine);\n381:     }\n382: \n383:     if (curChap && curLines.length > 50) {\n384:       curChap.text = cleanWatermarks(curLines.join('\\n').trim());\n385:       if (curChap.text.length > 400) chapters.push(curChap);\n386:     }\n387: \n388:     return chapters;\n389:   }\n390: \n391:   // Khusus Horus Rising (Warhammer 40k)\n392:   if (/horus\\s*rising|dan\\s*abnett/i.test(txtPath)) {\n393:     console.log('⚔️  Terdeteksi: The Horus Heresy - Horus Rising (Dan Abnett)!');\n394:     const chapters: Chapter[] = [];\n395:     let curPart = 'PROLOGUE';\n396:     let curChap: Chapter | null = null;\n397:     let curLines: string[] = [];\n398: \n399:     const numberWords = [\n400:       'ONE', 'TWO', 'THREE', 'FOUR', 'FIVE', 'SIX', 'SEVEN', 'EIGHT', 'NINE', 'TEN',\n401:       'ELEVEN', 'TWELVE', 'THIRTEEN', 'FOURTEEN', 'FIFTEEN', 'SIXTEEN', 'SEVENTEEN', 'EIGHTEEN', 'NINETEEN', 'TWENTY'\n402:     ];\n403: \n404:     for (let i = 0; i < lines.length; i++) {\n405:       const rawLine = lines[i];\n406:       const l = rawLine.trim();\n407: \n408:       const partMatch = l.match(/^PART\\s+(ONE|TWO|THREE|FOUR|FIVE)/i);\n409:       if (partMatch) {\n410:         curPart = `PART ${partMatch[1].toUpperCase()}`;\n411:         continue;\n412:       }\n413: \n414:       if (numberWords.includes(l.toUpperCase())) {\n415:         const prevLines = lines.slice(Math.max(0, i - 3), i).map(x => x.trim()).filter(Boolean);\n416:         const isAfterHeader = prevLines.some(x => /^\\d+$/i.test(x) || /Dan Abnett|Horus Rising/i.test(x));\n417:         const next1 = lines[i + 1]?.trim() || '';\n418:         const next2 = lines[i + 2]?.trim() || '';\n419:         const next3 = lines[i + 3]?.trim() || '';\n420:         const next4 = lines[i + 4]?.trim() || '';\n421: \n422:         const isHeading = isAfterHeader && next1.length > 0 && next1.length < 60 && !next1.endsWith('.');\n423:         if (isHeading) {\n424:           if (curChap && curLines.length > 5) {\n425:             curChap.text = cleanWatermarks(curLines.join('\\n'));\n426:             if (curChap.text.length > 200) chapters.push(curChap);\n427:           }\n428:           const chNum = String(chapters.length + 1).padStart(2, '0');\n429:           const subs = [next1, next2, next3, next4].filter(x => x && x.length < 60 && !x.endsWith('.'));\n430:           const subtitle = subs.join(' - ');\n431: \n432:           curChap = {\n433:             id: `horus_rising_ch${chNum}`,\n434:             title: `${curPart} - Chapter ${l.toUpperCase()}: ${subtitle}`,\n435:             text: ''\n436:           };\n437:           curLines = [];\n438:           i += subs.length;\n439:           continue;\n440:         }\n441:       }\n442: \n443:       if (!curChap && chapters.length === 0 && l.includes('It is a time of legend')) {\n444:         curChap = {\n445:           id: 'horus_rising_ch00',\n446:           title: 'PROLOGUE: Legend & Dramatis Personae',\n447:           text: ''\n448:         };\n449:       }\n450: "}
