.strip() for l in prev_text if l.strip() and not l.startswith(\"Volume\") and not \"ruidrive\" in l][-3:]\n                \n            next_lines = []\n            if page_num + 1 < len(doc):\n                next_text = doc[page_num + 1].get_text(\"text\").strip().split(\"\\n\")\n                next_lines = [l.strip() for l in next_text if l.strip() and not l.startswith(\"Volume\") and not \"ruidrive\" in l][:3]\n                \n            extracted.append({\n                \"page\": page_num + 1,\n                \"file\": img_filename,\n                \"path\": img_save_path,\n                \"width\": w,\n                \"height\": h,\n                \"is_color\": (page_num + 1) <= 15,\n                \"prev_context\": \" \".join(prev_lines),\n                \"next_context\": \" \".join(next_lines)\n            })\n\nmeta_path = os.path.join(output_dir, \"metadata.json\")\nwith open(meta_path, \"w\", encoding=\"utf-8\") as f:\n    json.dump(extracted, f, indent=2, ensure_ascii=False)\n\nprint(f\"Berhasil mengekstrak {len(extracted)} ilustrasi ke: {output_dir}\")\nprint(f\"Metadata tersimpan di: {meta_path}\")\n","Path":"C:\\Users\\Eevyx\\.gemini\\antigravity\\scratch\\extract_vol01_illustrations.py"}}]}
