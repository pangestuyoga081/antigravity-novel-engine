,\n432:       method: 'POST',\n433:       headers: {\n434:         'Content-Type': 'application/json',\n435:         'Authorization': `Bearer ${CONFIG.apiKey}`,\n436:         'Content-Length': Buffer.byteLength(payload)\n437:       },\n438:       timeout: 180000\n439:     }, (res) => {\n440:       let d = '';\n441:       res.on('data', c => d += c);\n442:       res.on('end', () => {\n443:         if (res.statusCode && res.statusCode >= 200 && res.statusCode < 300) {\n444:           resolve(d);\n445:         } else {\n446:           reject(new Error(`HTTP ${res.statusCode}: ${d}`));\n447:         }\n448:       });\n449:     });\n450:     req.on('error', reject);\n451:     req.on('timeout', () => req.destroy(new Error('Request Timeout')));\n452:     req.write(payload);\n453:     req.end();\n454:   });\n455: \n456:   return parseSSEorJSON(rawResponse);\n457: }\n458: \n459: async fu