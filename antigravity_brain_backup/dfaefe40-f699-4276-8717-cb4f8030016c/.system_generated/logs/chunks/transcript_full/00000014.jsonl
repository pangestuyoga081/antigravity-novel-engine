e;\n196:       }\n197: \n198:       // Deteksi awal bab riil\n199:       const isChap = /^(PROLOG(?:UE)?|EPILOG(?:UE)?|CHAPTER\\s+[0-9]+|INTERLUDE|SHORT\\s+STORY|EXTRA)/i.test(l);\n200:       if (isChap) {\n201:         const nextLines = lines.slice(i + 1, i + 8).map(x => x.trim()).filter(Boolean);\n202:         const isReal = nextLines.some(x => /^(Bagian\\s+[0-9]+|['\\\"“]|-)/i.test(x) || x.length > 30);\n203:         if (isReal) {\n204:           if (curChap && curLines.length > 50) {\n205:             curChap.text = cleanWatermarks(curLines.join('\\n').trim());\n206:             if (curChap.text.length > 400) chapters.push(curChap);\n207:           }\n208:           const chNum = String(chapters.length + 1).padStart(3, '0');\n209:           curChap = {\n210:             id: `${curVol.toLowerCase().replace(/[\\s.]+/g, '_')}_ch${chNum}`,\n211:             title: `${curVol} - ${l}`,\n212:             text: ''\n213:           };\n214:           curLines = [];\n215:           continue;\n216:         }\n217:       }\n218: \n219:       curLines.push(rawLine);\n220:     }\n221: \n222:     if (curChap && curLines.length > 50) {\n223:       curChap.text = cleanWatermarks(curLines.join('\\n').trim());\n224:       if (curChap.text.length > 400) chapters.push(curChap);\n225:     }\n226: \n227:     return chapters;\n228:   }\n229: \n230:   // Khusus Tom Clancy - Rainbow Six: gunakan mapping 41 bab presisi\n231:   if (/rainbow\\s*six/i.test(txtPath)) {\n232:     const chapterMeta = [\n233:       { no: 0, id: 'prolog', title: 'PROLOG: Situasi', rx: [/^\\s*PROLOG\\s*$/i] },\n234:       { no: 1, id: 'chap_01', title: 'BAB 1: Memorandum', rx: [/^\\s*MEMORANDUM\\s*$/i] },\n235:       { no: 2, id: 'chap_02', title: 'BAB 2: Beraksi, Koboi', rx: [/Pe CAI,\\s*COW-BOY/i] },\n236:       { no: 3, id: 'chap_03', title: 'BAB 3: Tim Pengintai & Pasukan Penembak', rx: [/PITICI\\s*ŞI\\s*PUŞCOACE/i, /^\\s*3\\s*$/] },\n237:       { no: 4, id: 'chap_04', title: 'BAB 4: Evaluasi Pasca Aksi (AAR)', rx: [/^\\s*ADA\\s*$/] },\n238:       { no: 5, id: 'chap_05', title: 'BAB 5: Cabang Masalah', rx: [/RAMIFICA/i, /^\\s*5\\s*$/] },\n239:       { no: 6, id: 'chap_06', title: 'BAB 6: Orang Beriman Sejati', rx: [/CREDINCIO|ADEV[AĂ]RA[TŢ]/i, /^\\s*6\\s*$/] },\n240:       { no: 7, id: 'chap_07', title: 'BAB 7: Finansial', rx: [/FINAN[TŢ]E/i, /^\\s*7\\s*$/] },\n241:       { no: 8, id: 'chap_08', title: 'BAB 8: Sorotan TV', rx: [/ŞTIAI\\s*TV|STIAI\\s*TV/i, /^\\s*8\\s*$/] },\n242:       { no: 9, id: 'chap_09', title: 'BAB 9: Pendekatan', rx: [/APROPIERI/i, /^\\s*9\\s*$/] },\n243:       { no: 10, id: 'chap_10', title: 'BAB 10: Penyelidikan Mendalam', rx: [/S[AĂ]P[AĂ]TURI/i, /^\\s*(10|IO)\\s*$/] },\n244:       { no: 11, id: 'chap_11', title: 'BAB 11: Infrastruktur', rx: [/INFRASTRUCTUR/i, /^\\s*(11|II)\\s*$/] },\n245:       { no: 12, id: 'chap_12', title: 'BAB 12: Tak Terduga dan Tak Terkendali', rx: [/Imprevizibil/i, /^\\s*12\\s*$/] },\n246:       { no: 13, id: 'chap_13', title: 'BAB 13: Taman Hiburan', rx: [/AMUZAMENT/i, /^\\s*13\\s*$/] },\n247:       { no: 14, id: 'chap_14', title: 'BAB 14: Pedang Pasukan', rx: [/SABIA\\s*LEGIUNII/i, /^\\s*14\\s*$/] },\n248:       { no: 15, id: 'chap_15', title: 'BAB 15: Topi Putih', rx: [/P[AĂ]L[AĂ]RII\\s*ALBE/i, /^\\s*(15|IS)\\s*$/] },\n249:       { no: 16, id: 'chap_16', title: 'BAB 16: Penemuan', rx: [/DESCOPERIREA/i, /^\\s*(16|IG)\\s*$/] },\n250:       { no: 17, id: 'chap_17', title: 'BAB 17: Radar Terbentang', rx: [/ANTENE\\s*[IÎ]NTINSE/i, /^\\s*17\\s*$/] },"}
