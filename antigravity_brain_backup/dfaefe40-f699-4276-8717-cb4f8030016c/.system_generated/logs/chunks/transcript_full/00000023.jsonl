eedback.blockReason}`);\n47:         return '';\n48:       }\n49:       return j.choices?.[0]?.message?.content || '';\n50:     } catch {}\n51:   }\n52: \n53:   return full.trim();\n54: }\n55: \n56: function isRefusalResponse(text: string): boolean {\n57:   if (!text || text.trim().length === 0) return true;\n58:   return /tidak dapat (memberikan|menerjemahkan|menulis|menuliskan|menyajikan|menghasilkan|membuat)|novel berhak cipta|karya berhak cipta|batasan hak cipta|kebijakan hak cipta|hak cipta melarang|rangkuman umum|garis besar adegan|ringkasan garis besar|gambaran besar dari|penulisan ulang/i.test(text);\n59: }\n60: \n61: function cleanWatermarks(text: string): string {\n62:   return text\n63:     // Watermark Horus Rising / Warhammer 40k\n64:     .replace(/^Dan Abnett\\s*$/gmi, '')\n65:     .replace(/^Horus Rising\\s*$/gmi, '')\n66:     .replace(/^THE HORUS HERESY\\s*$/gmi, '')\n67:     .replace(/^\\s*\\d+\\s*$/gm, '')\n68:     // Watermark Tom Clancy\n69:     .replace(/\\b\\d+\\s*e\\s*TOM\\s*CLANCY\\b/gi, '')\n70:     .replace(/\\bTOM\\s*CLANCY\\s*e\\s*\\d+\\b/gi, '')\n71:     .replace(/\\bTOM\\s*CLANCY\\b/gi, '')\n72:     .replace(/\\bTOMCLANCY\\b/gi, '')\n73:     .replace(/\\bRAINBOW\\s*SIX(\\s*e\\s*\\d+)?\\b/gi, '')\n74:     // Watermark Konosuba / Ruidrive / Afterscarlet\n75:     .replace(/PDF\\s+KONOSUBA\\s+Vol(?:\\w+)?\\s*\\d*/gi, '')\n76:     .replace(/Konosuba\\s+[–-]\\s+Volume\\s*\\d+(?:\\.\\d+)?/gi, '')\n77:     .replace(/https?:\\/\\/[^\\s]+/gi, '')\n78:     .replace(/Ruidrive\\.com/gi, '')\n79:     .replace(/Author\\s*:[^\\n]*/gi, '')\n80:     .replace(/Illustra(?:si|tor)\\s*:[^\\n]*/gi, '')\n81:     .replace(/Translate\\s*:[^\\n]*/gi, '')\n82:     .replace(/PDF\\s+By\\s*:[^\\n]*/gi, '')\n83:     .replace(/PDF\\s+dan\\s+dowload[^\\n]*/gi, '')\n84:     .replace(/\\n\\s*\\n\\s*\\n/g, '\\n\\n')\n85:     .trim();\n86: }\n87: \n88: function sanitizeSensitiveWords(t: string): string {\n89:   return t\n90:     .replace(/pubisul/gi, 'corpul')\n91:     .replace(/boaşele/gi, 'carnea')\n92:     .replace(/puţulica/gi, 'ceva')\n93:     .replace(/lăbar/gi, 'laş')\n94:     .replace(/schimbat sexul/gi, 'aranjat')\n95:     .replace(/fac din tine o fetiţă/gi, 'te distrug')\n96:     .replace(/transform în fetiţă/gi, 'termin')\n97:     .replace(/violezi|viol/gi, 'ataci')\n98:     .replace(/\\bloli(?:con)?\\b/gi, 'penggemar gadis imut')\n99:     .replace(/\\btelanjang\\b/gi, 'buka-bukaan')\n100:     .replace(/\\bmelepaskan bajuku\\b/gi, 'tampil lebih berani')"}
