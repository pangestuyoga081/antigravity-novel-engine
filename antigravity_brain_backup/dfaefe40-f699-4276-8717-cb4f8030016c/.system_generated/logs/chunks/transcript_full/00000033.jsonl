t Library)'),\n    15: ('map_route_09_kievskaya_park_pobedy.jpg', 'Peta Wilayah Barat Metro: Menuju Stasiun Smolenskaya & Kievskaya'),\n    16: ('map_route_10_mayakovskaya_belorusskaya.jpg', 'Rute Pasukan Ranger: Melewati Mayakovskaya & Terowongan Terbengkalai'),\n    17: ('map_route_10_mayakovskaya_belorusskaya.jpg', 'Peta Terowongan Sekte Penyembah Cacing Raksasa'),\n    18: ('map_route_11_metro2_d6_ostankino.jpg', 'Peta Rahasia Metro-2 (D-6): Kompleks Bunker Komando Militer Bawah Tanah'),\n    19: ('map_route_11_metro2_d6_ostankino.jpg', 'Rute Menara Ostankino: Perjalanan Permukaan Menuju Pemancar Tertinggi'),\n    20: ('map_route_11_metro2_d6_ostankino.jpg', 'Peta Sudut Pandang Menara Ostankino: Koordinat Sarang Si Hitam & Akhir Cerita')\n}\n\nsections = re.split(r'(?=^###\\s+)', text, flags=re.MULTILINE)\nnew_sections = []\n\nfor sec in sections:\n    if not sec.strip().startswith('###'):\n        new_sections.append(sec)\n        continue\n    \n    # Cari nomor bab\n    ch_match = re.search(r'CHAPTER\\s+([0-9]+)', sec, re.IGNORECASE)\n    if ch_match:\n        ch_num = int(ch_match.group(1))\n        if ch_num in map_inserts:\n            img_file, caption = map_inserts[ch_num]\n            # Sisipkan tag ilustrasi setelah header bab\n            lines = sec.split('\\n')\n            insert_idx = 0\n            for i, l in enumerate(lines):\n                if l.startswith('###') or l.startswith('====') or not l.strip():\n                    insert_idx = i + 1\n                else:\n                    break\n            \n            tag = f'\\n[[ILUSTRASI:{img_file}]]\\n*Ilustrasi Rute Perjalanan: {caption}*\\n'\n            lines.insert(insert_idx, tag)\n            sec = '\\n'.join(lines)\n            print(f'Inserted route map tag for Chapter {ch_num}: {img_file}')\n            \n    new_sections.append(sec)\n\nupdated_text = ''.join(new_sections)\nwith open(txt_path, 'w', encoding='utf-8') as f:\n    f.write(updated_text)\n\nprint('Updated TXT with all route map illustrations successfully!')\n\"","WaitMsBeforeAsync":5000,"toolSummary":"Insert route map illustration tags into TXT"}}]}
