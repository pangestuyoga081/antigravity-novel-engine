  \\\"height\\\": h,\\n                \\\"ext\\\": ext,\\n                \\\"size_kb\\\": size_kb,\\n                \\\"text_snippet\\\": first_line[:100]\\n            })\\n\\nprint(f\\\"\\\\nTotal Ilustrasi Valid Ditemukan: {len(images_found)}\\\")\\nfor i, img in enumerate(images_found):\\n    print(f\\\"[{i+1}] Halaman {img['page']} | {img['width']}x{img['height']} ({img['size_kb']:.1f} KB) | Teks: {img['text_snippet']}\\\")\\n\"","Path":"\"C:\\\\Users\\\\Eevyx\\\\.gemini\\\\antigravity\\\\scratch\\\\inspect_pdf_images.py\""}}]}
