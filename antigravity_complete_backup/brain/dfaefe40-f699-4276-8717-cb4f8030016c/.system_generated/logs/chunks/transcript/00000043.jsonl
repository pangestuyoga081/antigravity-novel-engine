{"step_index":4164,"source":"MODEL","type":"GENERIC","status":"DONE","created_at":"2026-11-20T02:45:21Z","content":"Created At: 2026-11-20T09:45:21+07:00\nCompleted At: 2026-11-20T09:45:21+07:00\nCreated At: 2026-11-20T09:45:21+07:00\nCompleted At: 2026-11-20T09:45:21+07:00\nShowing lines 1-100 of 1507\n1: #!/usr/bin/env node\r\n2: /**\r\n3:  * ============================================================================\r\n4:  * 🚇 NOVEL TRANSLATOR - DRAG & DROP RUNNER (ROBUST PROMPT & ZERO-REFUSAL)\r\n5:  * Multi-Novel Fast Pipeline with Resume, Auto Sub-Chunk & Style Adapter\r\n6:  * ============================================================================\r\n7:  */\r\n8: \r\n9: import fs from 'node:fs';\r\n10: import path from 'node:path';\r\n11: import readline from 'node:readline';\r\n12: import http from 'node:http';\r\n13: import https from 'node:https';\r\n14: import { execSync } from 'node:child_process';\r\n15: \r\n16: const CONFIG = {\r\n17:   proxyUrl: process.env.LLM_PROXY_URL || 'http://localhost:20128/v1/chat/completions',\r\n18:   model: process.env.LLM_MODEL || 'ag/gemini-3.8-flash-low',\r\n19:   apiKey: process.env.LLM_API_KEY || 'sk-2e591994696af18e-71ijj7-14263abd',\r\n20:   maxChunkChars: 6500,\r\n21:   concurrency: parseInt(process.env.CONCURRENCY || '15', 10)\r\n22: };\r\n23: \r\n24: interface Chapter {\r\n25:   id: string;\r\n26:   title: string;\r\n27:   text: string;\r\n28: }\r\n29: \r\n30: type StyleMode = 'dxd' | 'konosuba' | 'warhammer' | 'hobbit' | 'overlord' | 'mushoku' | 'dune' | 'metro' | 'default';\r\n31: \r\n32: function parseSSEorJSON(raw: string): string {\r\n33:   let full = '';\r\n34:   const lines = raw.split('\\n');\r\n35:   for (const l of lines) {\r\n36:     if (l.startsWith('data: ') && !l.includes('[DONE]')) {\r\n37:       try {\r\n38:         const j = JSON.parse(l.substring(6));\r\n39:         const delta = j.choices?.[0]?.delta?.content || j.choices?.[0]?.message?.content || '';\r\n40:         full += delta;\r\n41:       } catch {}\r\n42:     }\r\n43:   }\r\n44: \r\n45:   if (!full && raw.trim().startsWith('{')) {\r\n46:     try {\r\n47:       const j = JSON.parse(raw.trim());\r\n48:       if (j.response?.promptFeedback?.blockReason) {\r\n49:         console.warn(`   ⚠️ \n<truncated 839 bytes>\nerbolehkan)\\s+(untuk\\s+)?(menulis|menuliskan|menerjemahkan|menyajikan|membuat|mengadaptasi|memberikan)/i,\r\n68:     /secara\\s+(kata\\s+demi\\s+kata|baris\\s+demi\\s+baris|mendetail\\s+dari\\s+baris|detail\\s+atau\\s+menuliskannya)/i,\r\n69:     /(alih-alih|daripada)\\s+(menulis\\s+ulang|menerjemahkan)/i,\r\n70:     /(novel|karya)\\s+berhak\\s+cipta|(kebijakan|batasan|aturan)\\s+hak\\s+cipta|hak\\s+cipta\\s+melarang/i,\r\n71:     /naskah\\s+(novel\\s+)?aslinya/i,\r\n72:     /berikut\\s+(adalah\\s+)?(ringkasan|rangkuman|garis\\s+besar)/i,\r\n73:     /###\\s+(ringkasan|rangkuman|garis\\s+besar)/i,\r\n74:     /(ringkasan|rangkuman)\\s+(santai|singkat|umum|kejadian|cerita|mengenai|peristiwa|babak|adegan|alur)/i,\r\n75:     /secara\\s+garis\\s+besar/i,\r\n76:     /garis\\s+besar\\s+(adegan|bagian|cerita|peristiwa|mengenai|kejadian)/i,\r\n77:     /intisari\\s+(adegan|cerita|peristiwa)/i,\r\n78:     /apakah\\s+(kamu|anda)\\s+ingin\\s+(lanjut\\s+)?(menyimak|melihat|dengar|membaca|ringkasan|rangkuman|tahu)/i,\r\n79:     /mau\\s+(lanjut|tahu|aku\\s+buatin)\\s+(ke\\s+|bahas\\s+|dengerin\\s+|dengan\\s+)?(ringkasan|rangkuman|bagian\\s+berikutnya)/i,\r\n80:     /aku\\s+bisa\\s+kasih\\s+(ringkasan|rangkuman|gambaran|garis\\s+besar)/i,\r\n81:     /bagian\\s+awal\\s+perjalanan\\s+reinkarnasi/i,\r\n82:     /kisah\\s+awal\\s+reinkarnasi/i,\r\n83:     /permintaan\\s+(ini\\s+)?(meminta|untuk)/i,\r\n84:     /instruksi\\s+sistem\\s+melarang/i,\r\n85:     /tidak\\s+dapat\\s+dipenuhi/i,\r\n86:     /tanpa\\s+memuat\\s+unsur\\s+(pornografi|kata-kata)/i,\r\n87:     /penyampaian\\s+ulang\\s+isi\\s+teks/i,\r\n88:     /materi\\s+non-seksual/i\r\n89:   ];\r\n90:   return refusalPatterns.some(rx => rx.test(text));\r\n91: }\r\n92: \r\n93: function cleanWatermarks(text: string): string {\r\n94:   return text\r\n95:     // Watermark Overlord\r\n96:     .replace(/^PDF\\s+Overlo[a-z]*\\s+Vol[^\\n]*/gmi, '')\r\n97:     .replace(/^by\\s*:\\s*Kenny[^\\n]*/gmi, '')\r\n98:     .replace(/^Attention[\\s\\S]*?Dilarang keras[^\\n]*/gmi, '')\r\n99:     .replace(/^\\s*Overlord\\s*[–—\\-]\\s*Volume\\s*\\d+\\s*$/gmi, '')\r\n100:     .replace(/\\bOVERLORD\\s*[–—\\-]?\\s*VOLUME\\s*\\d+(\\s+\\d+)?\\b/gi, '')\r","truncated_fields":["content"]}
