Daftar project yang tersedia:');\r\n    for (const p of projects) {\r\n      console.log(`  â€¢ ID: ${p.id} | Nama: \"${p.name}\"`);\r\n    }\r\n    process.exit(1);\r\n  }\r\n\r\n  console.log(`ðŸ“ Project Target : \"${project.config.name}\" (ID: ${project.config.id})`);\r\n  console.log(`ðŸª Semesta        : ${project.config.universeTemplate}`);\r\n  console.log(`â³ Memulai generateStoryRoute via LLM...\\n`);\r\n\r\n  try {\r\n    // Jalankan generateRoute tanpa target buatan: biarkan LLM mengevaluasi kedalaman Lore dan menentukan struktur adaptif sendiri\r\n    const route = await storyRouteEngine.generateRoute(project.config.id);\r\n\r\n"}
