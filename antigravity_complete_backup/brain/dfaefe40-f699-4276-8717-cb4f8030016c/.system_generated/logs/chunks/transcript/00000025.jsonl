ce(/&nbsp;/g, ' ')\n      .replace(/&amp;/g, '&')\n      .replace(/&quot;/g, '\"')\n      .replace(/&apos;/g, \"'\")\n      .replace(/&lt;/g, '<')\n      .replace(/&gt;/g, '>')\n      .replace(/\\n\\s*\\n\\s*\\n/g, '\\n\\n')\n      .trim();\n\n    if (cleanText.length > 200) {\n      const lines = cleanText.split('\\n').map(l => l.trim()).filter(l => Boolean(l) && !/^(The\\s+Hobbit|Dune)\\s*$/i.test(l));\n      const firstRealLine = lines[0] || '';\n"}
