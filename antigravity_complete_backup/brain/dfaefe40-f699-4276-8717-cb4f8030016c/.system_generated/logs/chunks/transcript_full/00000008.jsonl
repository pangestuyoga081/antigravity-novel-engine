405:     const translatedParts = await mapConcurrent(chunks, CONFIG.concurrency, async (chunkText, idx) => {\n406:       const chunkFile = path.join(chapCacheDir, `chunk_${String(idx + 1).padStart(3, '0')}.txt`);\n407: \n408:       if (fs.existsSync(chunkFile)) {\n409:         const cached = fs.readFileSync(chunkFile, 'utf-8');\n410:         if (!isRefusalResponse(cached)) {\n411:           console.log(`   ⚡ Bagian [${idx + 1}/${chunks.length}] dimuat dari cache lokal.`);\n412:           return cached;\n413:         } else {\n414:           fs.rmSync(chunkFile, { force: true });\n415:         }\n416:       }\n417: \n418:       const prevContext = idx > 0 ? chunks[idx - 1] : null;\n419:       const tStart = Date.now();\n420:       const res = await callLLM(chunkText, prevContext);\n421:       const dur = ((Date.now() - tStart) / 1000).toFixed(1);\n422: \n423:       fs.writeFileSync(chunkFile, res, 'utf-8');\n424:       console.log(`   ⚡ Bagian [${idx + 1}/${chunks.length}] selesai (${dur}s) & dicache`);\n425:       return res;\n426:     });\n427: \n428:     const totalDur = ((Date.now() - startT) / 1000).toFixed(1);\n429:     console.log(`✅ Bab selesai dalam ${totalDur}s`);\n430: \n431:     // Terjemahkan judul bab ke Bahasa Indonesia\n432:     process.stdout.write(`   🏷️  Menerjemahkan judul bab... `);\n433:     const indonesianTitle = await translateTitle(ch.title);\n434:     console.log(`\"${indonesianTitle}\"`);\n435: \n436:     const chapterOutput = `\\n\\n${'='.repeat(70)}\\n### ${indonesianTitle}\\n${'='.repeat(70)}\\n\\n${translatedParts.join('\\n\\n')}\\n\\n`;\n437:     fs.appendFileSync(outputFile, chapterOutput, 'utf-8');\n438: \n439:     checkpoint.completedIds.push(ch.id);\n440:     fs.writeFileSync(checkpointFile, JSON.stringify(checkpoint, null, 2), 'utf-8');\n441:     console.log(`💾 Bab tersimpan ke output dan checkpoint.`);\n442:   }\n443: \n444:   console.log('\\n================================================================');\n445:   console.log