{"step_index":531,"source":"MODEL","type":"GENERIC","status":"DONE","created_at":"2026-11-12T02:51:47Z","content":"Created At: 2026-11-12T09:51:47+07:00\nCompleted At: 2026-11-12T09:51:49+07:00\nShowing lines 1-120 of 453\n1: #!/usr/bin/env node\n2: /**\n3:  * ============================================================================\n4:  * 🚇 NOVEL TRANSLATOR - DRAG & DROP RUNNER (ROBUST PROMPT & ZERO-REFUSAL)\n5:  * ============================================================================\n6:  */\n7: \n8: import fs from 'node:fs';\n9: import path from 'node:path';\n10: import readline from 'node:readline';\n11: import http from 'node:http';\n12: import { execSync } from 'node:child_process';\n13: \n14: const CONFIG = {\n15:   proxyUrl: 'http://127.0.0.1:20128/v1/chat/completions',\n16:   model: 'ag/gemini-3.8-flash',\n17:   apiKey: 'sk-2e591994696af18e-71ijj7-14263abd',\n18:   maxChunkChars: 8000,\n19:   concurrency: 3\n20: };\n21: \n22: interface Chapter {\n23:   id: string;\n24:   title: string;\n25:   text: string;\n26: }\n27: \n28: function isRefusalResponse(text: string): boolean {\n29:   if (!text || text.trim().length === 0) return true;\n30:   return /tidak dapat (memberikan|menerjemahkan)|novel berhak cipta|karya berhak cipta|ringkasan umum|garis besar adegan|copyright/i.test(text.substring(0, 300));\n31: }\n32: \n33: function extractEpubChapters(epubPath: string): Chapter[] {\n34:   console.log('📦 Membaca isi file EPUB...');\n35:   const tempDir = path.join(path.dirname(epubPath), '.temp_epub_extract');\n36:   if (fs.existsSync(tempDir)) fs.rmSync(tempDir, { recursive: true, force: true });\n37:   fs.mkdirSync(tempDir, { recursive: true });\n38: \n39:   try {\n40:     execSync(`tar -xf \"${epubPath}\" -C \"${tempDir}\"`, { stdio: 'pipe' });\n41:   } catch (err) {\n42:     throw new Error('Gagal mengekstrak EPUB: ' + err);\n43:   }\n44: \n45:   const chapters: Chapter[] = [];\n46:   function scanDir(dir: string) {\n47:     const entries = fs.readdirSync(dir, { withFileTypes: true });\n48:     for (const ent of entries) {\n49:       const full = path.join(dir, ent.name);\n50:       if (ent.isDirectory()) {\n51:         scanDir(full);\n52:       } else if (/\\.(html|xhtml)$/i.test(ent.name)) {\n53:         if (/cover|toc|bookmark|titlepage|copyright/i.test(ent.name)) continue;\n54:         \n55:         const html = fs.readFileSync(full, 'utf-8');\n56:         let cleanText = html\n57:           .replace(/<script\\b[^<]*(?:(?!<\\/script>)<[^<]*)*<\\/script>/gi, '')\n58:           .replace(/<style\\b[^<]*(?:(?!<\\/style>)<[^<]*)*<\\/style>/gi, '')\n59:           .replace(/<div class=\"cst\"><b>(.*?)<\\/b><\\/div>/gi, '\\nSubtitle: $1\\n')\n60:           .replace(/<div class=\"ct\"><b>(.*?)<\\/b><\\/div>/gi, '\\n\\n# $1\\n')\n61:           .replace(/<h[1-6][^>]*>(.*?)<\\/h[1-6]>/gi, '\\n\\n# $1\\n')\n62:           .replace(/<p[^>]*>/gi, '\\n')\n63:           .replace(/<div[^>]*>/gi, '\\n')\n64:           .replace(/<br\\s*[\\/]?>/gi, '\\n')\n65:           .replace(/<[^>]+>/g, '')\n66:           .replace(/&nbsp;/g, ' ')\n67:           .replace(/&amp;/g, '&')\n68:           .replace(/&quot;/g, '\"')\n69:           .replace(/&apos;/g, \"'\")\n70:           .replace(/&lt;/g, '<')\n71:           .replace(/&gt;/g, '>')\n72:           .replace(/\\n\\s*\\n\\s*\\n/g, '\\n\\n')\n73:           .trim();\n74: \n75:         if (cleanText.length > 500) {\n76:           const lines = cleanText.split('\\n').map(l => l.trim()).filter(Boolean);\n77:           const title = lines.slice(0, 2).join(' - ') || ent.name;\n78:           chapters.push({\n79:             id: path.basename(ent.name, path.extname(ent.name)),\n80:             title,\n81:             text: cleanText\n82:           });\n83:         }\n84:       }\n85:     }\n86:   }\n87: \n88:   scanDir(tempDir);\n89:   fs.rmSync(tempDir, { recursive: true, force: true });\n90:   chapters.sort((a, b) => a.id.localeCompare(b.id, undefined, { numeric: true, sensitivity: 'base' }));\n91:   return chapters;\n92: }\n93: \n94: function extractTxtChapters(txtPath: string): Chapter[] {\n95:   const content = fs.readFileSync(txtPath, 'utf-8');\n96:   const lines = content.split('\\n');\n97:   const chapters: Chapter[] = [];\n98:   let currentChap: Chapter | null = null;\n99:   let currentLines: string[] = [];\n100:   let chIndex = 1;\n101: \n102:   for (let i = 0; i < lines.length; i++) {\n103:     const rawLine = lines[i];\n104:     const line = rawLine.trim();\n105: \n106:     // 1. Bersihkan watermark buku / nomor halaman cetak\n107:     if (/^(TOM CLANCY\\b|RAINBOW SIX\\b|\\d+\\s+e\\s+TOM CLANCY|\\bRAINBOW SIX\\s+e\\s+\\d+)/i.test(line)) {\n108:       continue;\n109:     }\n110: \n111:     // 2. Bersihkan baris sampah karakter acak OCR\n112:     if (line.length < 5 && /^[|\\-=_~+`!?.a-z\\s]+$/i.test(line)) {\n113:       continue;\n114:     }\n115: \n116:     // Deteksi bab: baris pendek berisi angka bab atau kata PROLOG/EPILOG\n117:     const isNum = /^[0-9]{1,2}$/.test(line);\n118:     const isProlog = /^PROLOG$/i.test(line);\n119:     const isEpilog = /^EPILOG$/i.test(line);\n120:     const isExplicitHeading = /^(CHAPTER|BAB)\\s+[0-9]+/i.test(line);"}
