    reject(new Error(`HTTP ${res.statusCode}: ${d}`));\n224:             }\n225:           });\n226:         });\n227:         req.on('error', reject);\n228:         req.on('timeout', () => req.destroy(new Error('Request Timeout')));\n229:         req.write(payload);\n230:         req.end();\n231:       });\n232: \n233:       const cleanRes = resText.trim();\n234: \n235:       if (isRefusalResponse(cleanRes)) {\n236:         console.warn(`   ⚠️ [Percobaan ${attempt}] Terdeteksi penolakan, mencoba ulang...`);\n237:         if (attempt === retry) {\n238:           throw new Error('LLM menolak akibat filter copyright.');\n239:         }\n240:         await new Promise(r => setTimeout(r, 2000 * attempt));\n241:         continue;\n242:       }\n243: \n244:       return cleanRes;\n245:     } catch (err: any) {\n246:       console.warn(`⚠️ [Retry ${attempt}/${retry}] ${err.message}`);\n247:       if (attempt === retry) throw err;\n248:       await new Promise(r => setTimeout(r, 2000 * attempt));\n249:     }\n250:   }\n251: \n252:   throw new Error('LLM Translation Failed');\n253: }\n254: \n255: async function translateTitle(rawTitle: string): Promise<string> {\n256:   const cleanTitle = rawTitle.replace(/^#+\\s*/, '').trim();\n257:   if (/^PROLOG/i.test(cleanTitle)) return 'PROLOG';\n258:   if (/^EPILOG/i.test(cleanTitle)) return 'EPILOG';\n259: \n260:   try {"}
