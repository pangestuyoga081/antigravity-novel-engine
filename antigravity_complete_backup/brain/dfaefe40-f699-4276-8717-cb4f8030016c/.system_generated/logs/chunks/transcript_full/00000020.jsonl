{"step_index":1319,"source":"MODEL","type":"PLANNER_RESPONSE","status":"DONE","created_at":"2026-11-13T02:48:38Z","input_tokens":7172,"cache_read_tokens":203113,"output_tokens":5438,"thinking":"Every scene appears to be linked to a specific page and line within the source material. This mapping suggests a structured organization based on scene progression, with each image representing a distinct event within the narrative.\n\n\nThe scene-to-page mapping continues, now including specific line numbers within the text for each image. This reveals a plan to integrate images directly into the text at their corresponding narrative moments, enhancing the EPUB's visual storytelling. A preliminary chapter structure has been defined, reflecting the source material's organization. The script's primary task involves precisely locating and inserting the illustrations into their respective XHTML paragraphs.\n\n\n","tool_calls":[{"name":"write_file","args":{"Content":"import os\nimport zipfile\nimport html\nimport re\nimport json\n\nbase_dir = r\"D:\\JV\\novel yoga\"\ntxt_path = os.path.join(base_dir, \"Rokudenashi Majutsu Koushi to Akashic Records - Volume 01-24 (ID-Gaul-Combined).txt\")\nimg_dir = os.path.join(base_dir, \"illustrations\", \"Rokudenashi_Vol01\")\nepub_out = os.path.join(base_dir, \"Rokudenashi Majutsu Koushi to Akashic Records - Volume 01 (Illustrated).epub\")\n\nwith open(txt_path, \"r\", encoding=\"utf-8\") as f:\n    full_text = f.read()\n\nv1_idx = full_text.find(\"ROKUDENASHI MAJUTSU KOUSHI TO AKASHIC RECORDS - VOLUME 01\")\nv2_idx = full_text.find(\"ROKUDENASHI MAJUTSU KOUSHI TO AKASHIC RECORDS - VOLUME 02\")\nvol1_text = full_text[v1_idx:v2_idx if v2_idx != -1 else len(full_text)]\n\n# Pisahkan per bab\nraw_sections = re.split(r\"(?=###\\s+\\[VOLUME\\s+01\\])\", vol1_text)\n\nchapters = []\nfor sec in raw_sections:\n    sec = sec.strip()\n    if not sec.startswith(\"###\"):\n        continue\n    lines = sec.split(\"\\n\")\n    title_line = lines[0].replace(\"### [VOLUME 01]\", \"\").strip()\n    # buang tanda : di depan jika ada\n    title_line = re.sub(r\"^:\\s*\", \"\", title_line)\n    body = \"\\n\".join(lines[1:]).strip()\n    chapters.append({\n        \"title\": title_line,\n        \"body\": body\n    })\n\nprint(f\"Total Bab Terdeteksi: {len(chapters)}\")\nfor i, ch in enumerate(chapters):\n    print(f\"  [{i+1}] {ch['title']} ({len(ch['body'])} karakter)\")\n\n# Mapping penyisipan gambar hitam-putih ke teks adegan\n# (filename, regex pattern)\nbw_insertions = [\n    (\"vol01_p023_14593.jpeg\", r\"(Bukannya keder, Glenn malah menyeringai songong nantang Celica\\.)\"),\n    (\"vol01_p039_14643.jpeg\", r\"(Sistine Fibel: \\\"LU NGAPAIN ANJINGGG!\\?\\\")\"),\n    (\"vol01_p069_14735.jpeg\", r\"(Glenn Radars: \\\"Permisi\\.\\\")\"),\n    (\"vol01_p115_14875.jpeg\", r\"(Rumia memperhatikan punggung Glenn yang mendadak melangkah buru-buru mau keluar dari laboratorium\\.)\"),\n    (\"vol01_p147_14973.jpeg\", r\"(Glenn Radars: \\\"Nah, sekarang lu paham kan, Kucing Putih\\?.*?\\\")\"),\n    (\"vol01_p169_15041.jpeg\", r\"(Kenapa Celica nggak menua\\? Berapa usia aslinya\\?)\"),\n    (\"vol01_p225_15211.jpeg\", r\"(Pakaian dalam putih polos dan kulit mulusnya yang tanpa cela langsung terekspos terang)\"),\n    (\"vol01_p262_15324.jpeg\", r\"(Sistine Fibel: \\\"《Tolak dan halangi—》\\\")\"),\n    (\"vol01_p284_15392.jpeg\", r\"(Reik: \\\"Bego! Biar kata lu cuma ngerapel satu bait, gue tetep jauh lebih cepet!\\\")\"),\n    (\"vol01_p328_15526.jpeg\", r\"(Dan sensasi kekuatan mahadewa yang meluap dari rasa panas itu mulai mendominasi kesadaran Glenn—)\"),\n    (\"vol01_p351_15597.jpeg\", r\"(### \\[VOLUME 01\\] Kata Penutup|Semoga Anda menikmatinya|Taro Hitsuji)\")\n]\n\n# Terapkan penyisipan gambar ke body bab\nfor img_name, pattern in bw_insertions:\n    applied = False\n    for ch in chapters:\n        if re.search(pattern, ch[\"body\"]):\n            img_tag = f\"\\n\\n[[ILUSTRASI:{img_name}]]\\n\\n\"\n            ch[\"body\"] = re.sub(pattern, r\"\\1\" + img_tag, ch[\"body\"], count=1)\n            applied = True\n            print(f\"✅ Gambar {img_name} disisipkan ke bab: {ch['title']}\")\n            break\n    if not applied:\n        print(f\"⚠️ Gambar {img_name} tidak menemukan pola, disisipkan otomatis di akhir bab terkait.\")\n\n# Kumpulan gambar warna\ncolor_images = [\n    \"vol01_p001_14509.jpeg\",\n    \"vol01_p002_75.jpeg\",\n    \"vol01_p007_14509.jpeg\",\n    \"vol01_p008_14536.jpeg\",\n    \"vol01_p009_14541.jpeg\",\n    \"vol01_p010_14546.jpeg\",\n    \"vol01_p011_14551.jpeg\",\n    \"vol01_p012_14556.jpeg\",\n    \"vol01_p013_14561.jpeg\"\n]\n\n# Susun file EPUB\ncss_content = \"\"\"@charset \"utf-8\";\nbody {\n    margin: 5% 8%;\n    font-family: -apple-system, BlinkMacSystemFont, \"Segoe UI\", Roboto, Helvetica, Arial, sans-serif;\n    line-height: 1.8;\n    color: #2b2b2b;\n    background-color: #fafafa;\n    text-align: justify;\n}\nh1, h2, h3 {\n    text-align: center;\n    color: #1a1a1a;\n    margin-top: 1.5em;\n    margin-bottom: 1em;\n    font-weight: 700;\n}\np {\n    margin: 0.8em 0;\n    text-indent: 1.5em;\n}\np.dialogue {\n    text-indent: 0;\n    margin-left: 0.5em;\n    font-weight: 500;\n}\n.speaker {\n    font-weight: 700;\n    color: #0d47a1;\n}\n.illustration-container {\n    text-align: center;\n    margin: 2em 0;\n    page-break-inside: avoid;\n}\n.illustration-container img {\n    max-width: 100%;\n    height: auto;\n    border-radius: 4px;\n    box-shadow: 0 4px 10px rgba(0,0,0,0.15);\n}\n.color-gallery {\n    text-align: center;\n    page-break-after: always;\n}\n.color-gallery img {\n    max-width: 100%;\n    max-height: 90vh;\n    height: auto;\n    margin: 1em auto;\n}\n\"\"\"\n\ndef text_to_html(body_text):\n    paragraphs = body_text.split(\"\\n\")\n    html_parts = []\n    \n    for p in paragraphs:\n        p = p.strip()\n        if not p:\n            continue\n            \n        # Cek tag ilustrasi\n        img_match = re.match(r\"\\[\\[ILUSTRASI:(.*?)\\]\\]\", p)\n        if img_match:\n            img_file = img_match.group(1)\n            html_parts.append(f'<div class=\"illustration-container\"><img src=\"../images/{img_file}\" alt=\"Ilustrasi\" /></div>')\n            continue\n            \n        # Cek speaker dialog\n        spk_match = re.match(r\"^([^:]+?):\\s*\\\"(.*)\\\"$\", p)\n        if spk_match:\n            spk = html.escape(spk_match.group(1))\n            dial = html.escape(spk_match.group(2))\n            html_parts.append(f'<p class=\"dialogue\"><span class=\"speaker\">{spk}:</span> &ldquo;{dial}&rdquo;</p>')\n            continue\n            \n        esc_p = html.escape(p)\n        # Bold formatting\n        esc_p = re.sub(r\"\\*\\*(.*?)\\*\\*\", r\"<strong>\\1</strong>\", esc_p)\n        # Italic formatting\n        esc_p = re.sub(r\"\\*(.*?)\\*\", r\"<em>\\1</em>\", esc_p)\n        html_parts.append(f\"<p>{esc_p}</p>\")\n        \n    return \"\\n\".join(html_parts)\n\n# Buat berkas-berkas XHTML bab\nxhtml_files = []\n\n# 1. Halaman Galeri Warna (Color Spreads)\ncolor_html_parts = ['<div class=\"color-gallery\"><h1>Ilustrasi Berwarna</h1>']\nfor c_img in color_images:\n    color_html_parts.append(f'<div class=\"illustration-container\"><img src=\"../images/{c_img}\" alt=\"Ilustrasi Warna\" /></div>')\ncolor_html_parts.append('</div>')\n\ncolor_xhtml = f\"\"\"<?xml version=\"1.0\" encoding=\"utf-8\"?>\n<!DOCTYPE html>\n<html xmlns=\"http://www.w3.org/1999/xhtml\" xmlns:epub=\"http://www.idpf.org/2007/ops\">\n<head>\n<title>Galeri Ilustrasi Berwarna</title>\n<link rel=\"stylesheet\" type=\"text/css\" href=\"../css/stylesheet.css\"/>\n</head>\n<body>\n{\"\".join(color_html_parts)}\n</body>\n</html>\"\"\"\nxhtml_files.append((\"gallery.xhtml\", \"Galeri Ilustrasi Berwarna\", color_xhtml))\n\n# 2. Tiap Bab\nfor idx, ch in enumerate(chapters):\n    filename = f\"chapter_{idx+1:02d}.xhtml\"\n    title_esc = html.escape(ch[\"title\"])\n    body_html = text_to_html(ch[\"body\"])\n    \n    doc_xhtml = f\"\"\"<?xml version=\"1.0\" encoding=\"utf-8\"?>\n<!DOCTYPE html>\n<html xmlns=\"http://www.w3.org/1999/xhtml\" xmlns:epub=\"http://www.idpf.org/2007/ops\">\n<head>\n<title>{title_esc}</title>\n<link rel=\"stylesheet\" type=\"text/css\" href=\"../css/stylesheet.css\"/>\n</head>\n<body>\n<h2>{title_esc}</h2>\n{body_html}\n</body>\n</html>\"\"\"\n    xhtml_files.append((filename, ch[\"title\"], doc_xhtml))\n\n# Kemas ke ZIP/EPUB\nwith zipfile.ZipFile(epub_out, \"w\") as z:\n    # 1. mimetype (Wajib paling awal dan uncompressed / ZIP_STORED)\n    z.writestr(\"mimetype\", \"application/epub+zip\", compress_type=zipfile.ZIP_STORED)\n    \n    # 2. META-INF/container.xml\n    container_xml = \"\"\"<?xml version=\"1.0\" encoding=\"UTF-8\"?>\n<container version=\"1.0\" xmlns=\"urn:oasis:names:tc:opendocument:xmlns:container\">\n    <rootfiles>\n        <rootfile full-path=\"OEBPS/content.opf\" media-type=\"application/oebps-package+xml\"/>\n    </rootfiles>\n</container>\"\"\"\n    z.writestr(\"META-INF/container.xml\", container_xml, compress_type=zipfile.ZIP_DEFLATED)\n    \n    # 3. CSS\n    z.writestr(\"OEBPS/css/stylesheet.css\", css_content, compress_type=zipfile.ZIP_DEFLATED)\n    \n    # 4. Gambar-gambar\n    all_img_files = os.listdir(img_dir)\n    manifest_images = []\n    for f in all_img_files:\n        if f.endswith((\".jpeg\", \".jpg\", \".png\")):\n            full_path = os.path.join(img_dir, f)\n            with open(full_path, \"rb\") as img_f:\n                z.writestr(f\"OEBPS/images/{f}\", img_f.read(), compress_type=zipfile.ZIP_DEFLATED)\n            item_id = f\"img_{f.replace('.', '_')}\"\n            media_type = \"image/jpeg\" if f.endswith((\".jpeg\", \".jpg\")) else \"image/png\"\n            manifest_images.append(f'<item id=\"{item_id}\" href=\"images/{f}\" media-type=\"{media_type}\"/>')\n            \n    # 5. XHTML Chapters\n    manifest_items = []\n    spine_items = []\n    toc_ncx_items = []\n    nav_html_items = []\n    \n    for idx, (fname, title, xhtml_body) in enumerate(xhtml_files):\n        z.writestr(f\"OEBPS/text/{fname}\", xhtml_body, compress_type=zipfile.ZIP_DEFLATED)\n        item_id = f\"item_{idx+1}\"\n        manifest_items.append(f'<item id=\"{item_id}\" href=\"text/{fname}\" media-type=\"application/xhtml+xml\"/>')\n        spine_items.append(f'<itemref idref=\"{item_id}\"/>')\n        \n        toc_ncx_items.append(f\"\"\"<navPoint id=\"np_{idx+1}\" playOrder=\"{idx+1}\">\n            <navLabel><text>{html.escape(title)}</text></navLabel>\n            <content src=\"text/{fname}\"/>\n        </navPoint>\"\"\")\n        \n        nav_html_items.append(f'<li><a href=\"text/{fname}\">{html.escape(title)}</a></li>')\n        \n    # 6. TOC.ncx\n    toc_ncx = f\"\"\"<?xml version=\"1.0\" encoding=\"UTF-8\"?>\n<ncx xmlns=\"http://www.daisy.org/z3986/2005/ncx/\" version=\"2005-1\">\n    <head>\n        <meta name=\"dtb:uid\" content=\"urn:uuid:rokudenashi-vol01-id-direct\"/>\n        <meta name=\"dtb:depth\" content=\"1\"/>\n        <meta name=\"dtb:totalPageCount\" content=\"0\"/>\n        <meta name=\"dtb:maxPageNumber\" content=\"0\"/>\n    </head>\n    <docTitle><text>Rokudenashi Majutsu Koushi to Akashic Records - Volume 01</text></docTitle>\n    <navMap>\n        {\"\".join(toc_ncx_items)}\n    </navMap>\n</ncx>\"\"\"\n    z.writestr(\"OEBPS/toc.ncx\", toc_ncx, compress_type=zipfile.ZIP_DEFLATED)\n    \n    # 7. nav.xhtml\n    nav_xhtml = f\"\"\"<?xml version=\"1.0\" encoding=\"utf-8\"?>\n<!DOCTYPE html>\n<html xmlns=\"http://www.w3.org/1999/xhtml\" xmlns:epub=\"http://www.idpf.org/2007/ops\">\n<head>\n<title>Daftar Isi</title>\n<link rel=\"stylesheet\" type=\"text/css\" href=\"css/stylesheet.css\"/>\n</head>\n<body>\n<nav epub:type=\"toc\" id=\"toc\">\n    <h1>Daftar Isi</h1>\n    <ol>\n        {\"\".join(nav_html_items)}\n    </ol>\n</nav>\n</body>\n</html>\"\"\"\n    z.writestr(\"OEBPS/nav.xhtml\", nav_xhtml, compress_type=zipfile.ZIP_DEFLATED)\n    \n    # 8. content.opf\n    cover_img_id = \"img_vol01_p001_14509_jpeg\"\n    content_opf = f\"\"\"<?xml version=\"1.0\" encoding=\"UTF-8\"?>\n<package xmlns=\"http://www.idpf.org/2007/opf\" unique-identifier=\"BookID\" version=\"3.0\">\n    <metadata xmlns:dc=\"http://purl.org/dc/elements/1.1/\">\n        <dc:title>Rokudenashi Majutsu Koushi to Akashic Records - Volume 01</dc:title>\n        <dc:creator>Taro Hitsuji</dc:creator>\n        <dc:language>id</dc:language>\n        <dc:identifier id=\"BookID\">urn:uuid:rokudenashi-vol01-id-direct</dc:identifier>\n        <meta name=\"cover\" content=\"{cover_img_id}\"/>\n    </metadata>\n    <manifest>\n        <item id=\"ncx\" href=\"toc.ncx\" media-type=\"application/x-dtbncx+xml\"/>\n        <item id=\"nav\" href=\"nav.xhtml\" media-type=\"application/xhtml+xml\" properties=\"nav\"/>\n        <item id=\"css\" href=\"css/stylesheet.css\" media-type=\"text/css\"/>\n        {\"\".join(manifest_items)}\n        {\"\".join(manifest_images)}\n    </manifest>\n    <spine toc=\"ncx\">\n        {\"\".join(spine_items)}\n    </spine>\n</package>\"\"\"\n    z.writestr(\"OEBPS/content.opf\", content_opf, compress_type=zipfile.ZIP_DEFLATED)\n\nprint(f\"\\n🎉 EPUB SUKSES DIBUAT!\")\nprint(f\"📄 Lokasi: {epub_out}\")\nprint(f\"📊 Ukuran File: {(os.path.getsize(epub_out)/(1024*1024)):.2f} MB\")\n","Path":"C:\\Users\\Eevyx\\.gemini\\antigravity\\scratch\\build_illustrated_epub.py"}}]}
