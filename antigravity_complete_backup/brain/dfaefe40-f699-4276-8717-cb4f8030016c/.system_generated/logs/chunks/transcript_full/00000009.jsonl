.delta?.content || j.choices?.[0]?.message?.content || '';\n        full += delta;\n      } catch {}\n    }\n  }\n  return full;\n}\n\nasync function test(prompt) {\n  const payload = JSON.stringify({\n    model: 'ag/gemini-3.8-flash',\n    messages: [{ role: 'user', content: prompt }],\n    temperature: 0.6,\n    stream: false\n  });\n\n  return new Promise((resolve) => {\n    const req = http.request({\n      hostname: '127.0.0.1',\n      port: 20128,\n      path: '/v1/chat/completions',\n      method: 'POST',\n      headers: {\n        'Content-Type': 'application/json',\n        'Authorization': 'Bearer sk-2e591994696af18e-71ijj7-14263abd',\n        'Content-Length': Buffer.byteLength(payload)\n      },\n      timeout: 30000\n    }, res => {\n      let d = '';\n      res.on('data', c => d += c);\n      res.on('end', () => {\n        resolve(parseSSEorJSON(d));\n      });\n    });\n    req.on('error', e => resolve(e.message));\n    req.write(payload);\n    req.end();\n  });\n}\n\nasync function run() {\n  console.log('Testing Prompt 1 (Current)...');\n  const p1 = `Berikut adalah draf naskah mentah berbahasa Rumania. Tolong terjemahkan dan lokalisasikan dialog serta adegan aksi ini ke Bahasa Indonesia santai (lu-gue) to-the-point tanpa bertele-tele. Format dialog sertakan Nama: \"...\". Terjemahkan baris demi baris secara lengkap:\\n\\n${text}`;\n  const res1 = await test(p1);\n  console.log('PARSED CONTENT:\\n', res1);\n}\n\nrun();\n","Overwrite":true,"Path":"C:\\Users\\Eevyx\\.gemini\\antigravity\\brain\\dfaefe40-f699-4276-8717-cb4f8030016c\\scratch\\test_prompt.js"}}]}
