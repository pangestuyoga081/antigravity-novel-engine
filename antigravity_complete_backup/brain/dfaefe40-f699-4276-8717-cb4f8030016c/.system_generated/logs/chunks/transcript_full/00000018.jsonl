[0-9]+|INTERLUDE|SHORT\\s+STORY|EXTRA)/i.test(l);\n214:       if (isChap) {\n215:         const nextLines = lines.slice(i + 1, i + 8).map(x => x.trim()).filter(Boolean);\n216:         const isReal = nextLines.some(x => /^(Bagian\\s+[0-9]+|['\\\"“]|-)/i.test(x) || x.length > 30);\n217:         if (isReal) {\n218:           if (curChap && curLines.length > 50) {\n219:             curChap.text = cleanWatermarks(curLines.join('\\n').trim());\n220:             if (curChap.text.length > 400) chapters.push(curChap);\n221:           }\n222:           const chNum = String(chapters.length + 1).padStart(3, '0');\n223:           curChap = {\n224:             id: `${curVol.toLowerCase().replace(/[\\s.]+/g, '_')}_ch${chNum}`,\n225:             title: `${curVol} - ${l}`,\n226:             text: ''\n227:           };\n228:           curLines = [];\n229:           continue;\n230:         }\n231:       }\n232: \n233:       curLines.push(rawLine);\n234:     }\n235: \n236:     if (curChap && curLines.length > 50) {\n237:       curChap.text = cleanWatermarks(curLines.join('\\n').trim());\n238:       if (curChap.text.length > 400) chapters.push(curChap);\n239:     }\n240: "}
