{"step_index":1166,"source":"MODEL","type":"GENERIC","status":"DONE","created_at":"2026-11-12T08:36:38Z","content":"Created At: 2026-11-12T15:36:38+07:00\nCompleted At: 2026-11-12T15:36:38+07:00\nShowing lines 160-235 of 650\n160:     }\n161:   }\n162: \n163:   scanDir(tempDir);\n164:   fs.rmSync(tempDir, { recursive: true, force: true });\n165:   chapters.sort((a, b) => a.id.localeCompare(b.id, undefined, { numeric: true, sensitivity: 'base' }));\n166:   return chapters;\n167: }\n168: \n169: function extractTxtChapters(txtPath: string): Chapter[] {\n170:   const content = fs.readFileSync(txtPath, 'utf-8');\n171:   const lines = content.split('\\n');\n172: \n173:   // Khusus Konosuba: Kono Subarashii Sekai ni Shukufuku wo!\n174:   if (/konosuba|kono\\s*subarashii/i.test(txtPath)) {\n175:     console.log('🎌 Terdeteksi: Kompilasi Light Novel Konosuba (Volume 01-17 + Bakuen)!');\n176:     const chapters: Chapter[] = [];\n177:     let curVol = 'VOLUME 01';\n178:     let curChap: Chapter | null = null;\n179:     let curLines: string[] = [];\n180: \n181:     for (let i = 0; i < lines.length; i++) {\n182:       const rawLine = lines[i];\n183:       const l = rawLine.trim();\n184: \n185:       const vm = l.match(/^KONO SUBARASHII SEKAI NI SHUKUFUKU WO! - (VOLUME\\s+[0-9]+(?:\\.[0-9]+)?)/i);\n186:       if (vm) {\n187:         if (curChap && curLines.length > 50) {\n188:           curChap.text = cleanWatermarks(curLines.join('\\n').trim());\n189:           if (curChap.text.length > 400) chapters.push(curChap);\n190:         }\n191:         curVol = vm[1].toUpperCase();\n192:         curChap = null;\n193:         curLines = [];\n194:         continue;\n195:       }\n196: \n197:       // Lewati daftar isi (TOC)\n198:       if (l.startsWith('#') || /^(List\\s+Chapter|Index|Attention|Warning!)/i.test(l)) {\n199:         continue;\n200:       }\n201: \n202:       // Filter nomor halaman tunggal\n203:       if (/^\\d+$/.test(l) && l.length < 5) {\n204:         continue;\n205:       }\n206: \n207:       // Deteksi awal bab riil\n208:       const isChap = /^(PROLOG(?:UE)?|EPILOG(?:UE)?|CHAPTER\\s+[0-9]+|INTERLUDE|SHORT\\s+STORY|EXTRA)/i.test(l);\n209:       if (isChap) {\n210:         const nextLines = lines.slice(i + 1, i + 8).map(x => x.trim()).filter(Boolean);\n211:         const isReal = nextLines.some(x => /^(Bagian\\s+[0-9]+|['\\\"“]|-)/i.test(x) || x.length > 30);\n212:         if (isReal) {\n213:           if (curChap && curLines.length > 50) {\n214:             curChap.text = cleanWatermarks(curLines.join('\\n').trim());\n215:             if (curChap.text.length > 400) chapters.push(curChap);\n216:           }\n217:           const chNum = String(chapters.length + 1).padStart(3, '0');\n218:           curChap = {\n219:             id: `${curVol.toLowerCase().replace(/[\\s.]+/g, '_')}_ch${chNum}`,\n220:             title: `${curVol} - ${l}`,\n221:             text: ''\n222:           };\n223:           curLines = [];\n224:           continue;\n225:         }\n226:       }\n227: \n228:       curLines.push(rawLine);\n229:     }\n230: \n231:     if (curChap && curLines.length > 50) {\n232:       curChap.text = cleanWatermarks(curLines.join('\\n').trim());\n233:       if (curChap.text.length > 400) chapters.push(curChap);\n234:     }\n235: "}
