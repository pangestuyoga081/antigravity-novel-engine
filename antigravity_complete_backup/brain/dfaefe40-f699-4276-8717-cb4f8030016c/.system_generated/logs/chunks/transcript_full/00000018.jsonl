etedIds.includes(ch.id)) {\n590:       console.log(`⏭️  [${i + 1}/${chapters.length}] Lewati: ${ch.title} (Sudah selesai)`);\n591:       continue;\n592:     }\n593: \n594:     console.log(`----------------------------------------------------------------`);\n595:     console.log(`📖 [${i + 1}/${chapters.length}] Memproses: ${ch.title} (~${ch.text.length} karakter)`);\n596:     console.log(`----------------------------------------------------------------`);\n597: \n598:     const chapCacheDir = path.join(cacheDir, ch.id);\n599:     if (!fs.existsSync(chapCacheDir)) {\n600:       fs.mkdirSync(chapCacheDir, { recursive: true });\n601:     }\n602: \n603:     const chunks = splitParagraphSafe(ch.text, CONFIG.maxChunkChars);\n604:     console.log(`📦 Dibagi menjadi ${chunks.length} bagian chunk...`);\n605: \n606:     const startT = Date.now();\n607:     const translatedParts = await mapConcurrent(chunks, CONFIG.concurrency, async (chunkText, idx) => {\n608:       const chunkFile = path.join(chapCacheDir, `chunk_${String(idx + 1).padStart(3, '0')}.txt`);\n609: \n610:       if (fs.existsSync(chunkFile)) {\n611:         const cached = fs.readFileSync(chunkFile, 'utf-8');\n612:         if (!isRefusalResponse(cached) && cached.length > 50) {\n613:           console.log(`   ⚡ Bagian [${idx + 1}/${chunks.length}] dimuat dari cache lokal.`);\n614:           return cached;\n615:         } else {\n616:           fs.rmSync(chunkFile, { force: true });\n617:         }\n618:       }\n619: \n620:       const prevContext = idx > 0 ? chunks[idx - 1] : null;\n621:       const tStart = Date.now();\n622:       const res = await callLLM(chunkText, prevContext, isKonosuba);\n623:       const dur = ((Date.now() - tStart) / 1000).toFixed(1);\n624: \n625:       fs.writeFileSync(chunkFile, res, 'utf-8');\n626:       console.log(`   ⚡ Bagian [${idx + 1}/${chunks.length}] selesai (${dur}s) & dicache`);\n627:       return res;\n628:     });\n629: \n630:     const totalDur = ((Date.now() - startT) / 1000).toFixed(1);\n631:     console.log(`✅ Bab selesai dalam ${totalDur}s`);\n632: \n633:     const chapterOutput = `\\n\\n${'='.repeat(70)}\\n### ${ch.title}\\n${'='.repeat(70)}\\n\\n${translatedParts.join('\\n\\n')}\\n\\n`;\n634:     fs.appendFileSync(outputFile, chapterOutput, 'utf-8');\n635: \n636:     checkpoint.completedIds.push(ch.id);\n637:     fs.writeFileSync(checkpointFile, JSON.stringify(checkpoint, null, 2), 'utf-8');\n638:     console.log(`💾 Bab tersimpan ke output dan checkpoint.`);\n639:   }\n640: "}
