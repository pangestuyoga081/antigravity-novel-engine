;\n        } catch (e) {\n          resolve({ model: modelName, error: data });\n        }\n      });\n    });\n    req.on('error', e => resolve({ model: modelName, error: e.message }));\n    req.write(payload);\n    req.end();\n  });\n}\n\nasync function main() {\n  console.log('Testing mimo-v2.6-pro...');\n  const res = await testModel('mimo-v2.6-pro');\n  console.log('Duration:', res.duration, 'ms');\n  console.log('Response:');\n  console.log(res.content);\n}\n\nmain();\n","Path":"D:/JV/novel yoga/test_mimo.js"}}]}
