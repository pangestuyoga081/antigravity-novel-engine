{"step_index":2763,"source":"MODEL","type":"PLANNER_RESPONSE","status":"DONE","created_at":"2026-11-18T07:09:48Z","input_tokens":2344,"cache_read_tokens":73773,"output_tokens":959,"tool_calls":[{"name":"write_file","args":{"Content":"const http = require('http');\n\nconst API_URL = 'http://localhost:20128/v1/chat/completions';\nconst API_KEY = 'sk-2e591994696af18e-71ijj7-14263abd';\nconst MODEL = 'ag/gemini-3.8-flash';\n\nconst prompt = `Terjemahkan kalimat taktis ini ke bahasa Indonesia santai: \"Target in sight, moving to breach point.\"`;\n\nfunction sendRequest(id) {\n  return new Promise((resolve) => {\n    const payload = JSON.stringify({\n      model: MODEL,\n      messages: [{ role: 'user', content: prompt }],\n      temperature: 0.6\n    });\n\n    const start = Date.now();\n    const req = http.request({\n      hostname: 'localhost',\n      port: 20128,\n      path: '/v1/chat/completions',\n      method: 'POST',\n      headers: {\n        'Content-Type': 'application/json',\n        'Authorization': `Bearer ${API_KEY}`,\n        'Content-Length': Buffer.byteLength(payload)\n      },\n      timeout: 30000\n    }, (res) => {\n      let data = '';\n      res.on('data', c => data += c);\n      res.on('end', () => {\n        const dur = Date.now() - start;\n        if (res.statusCode >= 200 && res.statusCode < 300) {\n          resolve({ id, ok: true, status: res.statusCode, dur });\n        } else {\n          resolve({ id, ok: false, status: res.statusCode, dur, error: data.substring(0, 150) });\n        }\n      });\n    });\n\n    req.on('error', (e) => {\n      resolve({ id, ok: false, status: 0, dur: Date.now() - start, error: e.message });\n    });\n    req.on('timeout', () => {\n      req.destroy();\n      resolve({ id, ok: false, status: 408, dur: Date.now() - start, error: 'Timeout' });\n    });\n\n    req.write(payload);\n    req.end();\n  });\n}\n\nasync function testConcurrency(concurrency) {\n  console.log(`\\n--- Menguji Concurrency ${concurrency} workers ---`);\n  const promises = [];\n  for (let i = 1; i <= concurrency; i++) {\n    promises.push(sendRequest(i));\n  }\n  const results = await Promise.all(promises);\n  const success = results.filter(r => r.ok).length;\n  const failed = results.filter(r => !r.ok);\n  const avgDur = Math.round(results.filter(r => r.ok).reduce((a, b) => a + b.dur, 0) / (success || 1));\n\n  console.log(`Hasil: ${success}/${concurrency} Berhasil. Rata-rata: ${avgDur}ms.`);\n  if (failed.length > 0) {\n    console.log(`Gagal ${failed.length} request: Status ${failed[0].status} - ${failed[0].error}`);\n    return false;\n  }\n  return true;\n}\n\nasync function main() {\n  console.log('Target Router: 9router (ag/gemini-3.8-flash)');\n  const levels = [3, 5, 8, 10, 15, 20];\n  for (const c of levels) {\n    const ok = await testConcurrency(c);\n    if (!ok) {\n      console.log(`\\n⚠️ Limit/Kegagalan terdeteksi pada ${c} workers!`);\n      break;\n    }\n    await new Promise(r => setTimeout(r, 1000));\n  }\n}\n\nmain();\n","Path":"D:/JV/novel yoga/stress_test_9router.js"}}]}
