ch (e) {\n          resolve({ model: modelName, error: data });\n        }\n      });\n    });\n    req.on('error', e => resolve({ model: modelName, error: e.message }));\n    req.write(payload);\n    req.end();\n  });\n}\n\nasync function main() {\n  console.log('Testing deepseek-v3.2 vs deepseek-v4.1-flash...');\n  const resV3 = await testModel('deepseek-v3.2');\n  const resV4 = await testModel('deepseek-v4.1-flash');\n  console.log('=== V3.2 ===');\n  console.log(resV3.content);\n  console.log('\\n=== V4.1 FLASH ===');\n  console.log(resV4.content);\n}\n\nmain();\n","Path":"D:/JV/novel yoga/test_v3_vs_v4.js"}}]}
