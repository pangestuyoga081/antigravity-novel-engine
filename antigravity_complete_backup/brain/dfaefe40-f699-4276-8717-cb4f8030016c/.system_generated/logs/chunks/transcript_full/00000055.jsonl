{"step_index":4366,"source":"MODEL","type":"GENERIC","status":"DONE","created_at":"2026-11-22T04:38:08Z","content":"Created At: 2026-11-22T11:38:08+07:00\nCompleted At: 2026-11-22T11:38:08+07:00\nCreated At: 2026-11-22T11:38:08+07:00\nCompleted At: 2026-11-22T11:38:08+07:00\nShowing lines 1-100 of 176\n1: #!/usr/bin/env python3\n2: \"\"\"\n3: Ruidrive & Ruisafe Link Extractor\n4: Bypasses safelinks and extracts direct download links from Ruidrive series pages.\n5: Requires only Python 3 standard library.\n6: \"\"\"\n7: \n8: import sys\n9: import re\n10: import json\n11: import base64\n12: import urllib.request\n13: import urllib.parse\n14: from typing import Dict, List, Optional, Tuple\n15: \n16: USER_AGENT = \"Mozilla/5.0 (Windows NT 10.0; Win64; x64) AppleWebKit/537.36 (KHTML, like Gecko) Chrome/120.0.0.0 Safari/537.36\"\n17: \n18: def fetch_html(url: str) -> Optional[str]:\n19:     \"\"\"Fetches HTML content with custom user-agent.\"\"\"\n20:     req = urllib.request.Request(url, headers={'User-Agent': USER_AGENT})\n21:     try:\n22:         with urllib.request.urlopen(req, timeout=15) as resp:\n23:             return resp.read().decode('utf-8', errors='ignore')\n24:     except Exception as e:\n25:         print(f\"[-] Gagal mengambil {url}: {e}\", file=sys.stderr)\n26:         return None\n27: \n28: def decode_ruisafe(url: str) -> str:\n29:     \"\"\"Decodes a ruisafe safelink URL if it contains a base64 encoded 'url' query param.\"\"\"\n30:     parsed = urllib.parse.urlparse(url)\n31:     qs = urllib.parse.parse_qs(parsed.query)\n32:     if 'url' in qs:\n33:         b64 = qs['url'][0]\n34:         # Add padding if needed\n35:         b64 += '=' * (-len(b64) % 4)\n36:         try:\n37:             return base64.b64decode(b64).decode('utf-8', errors='ignore')\n38:         except Exception:\n39:             pass\n40:     return url\n41: \n42: def extract_label_from_page(html: str) -> Optional[str]:\n43:     \"\"\"Finds the series label feed from Ruidrive main page.\"\"\"\n44:     # Look for script feed pattern: /feeds/posts/default/-/<LABEL>?...\n45:     match = re.search(r'/feeds/posts/default/-/([^?\\'\"]+)\\?[^\"\\']*callback=showrecentposts', html)\n46:     if match:\n47:         return urllib.parse.unquote(match.group(1))\n48:     \n49:     # Alternative search for feeds\n50:     match = re.search(r'/feeds/posts/default/-/([^?\\'\"]+)', html)\n51:     if match:\n52:         label = urllib.parse.unquote(match.group(1))\n53:         if not label.startswith('$') and label != \"\":\n54:             return label\n55:     return None\n56: \n57: def get_volume_posts(domain: str, label: str) -> List[Tuple[float, str, str, str]]:\n58:     \"\"\"\n59:     Fetches all posts tagged with `label` from Blogger JSON feed.\n60:     Returns list of (volume_float, volume_str, title, post_url).\n61:     \"\"\"\n62:     encoded_label = urllib.parse.quote(label)\n63:     feed_url = f\"https://{domain}/feeds/posts/default/-/{encoded_label}?orderby=published&alt=json&max-results=999\"\n64:     \n65:     req = urllib.request.Request(feed_url, headers={'User-Agent': USER_AGENT})\n66:     try:\n67:         with urllib.request.urlopen(req, timeout=15) as resp:\n68:             data = json.loads(resp.read().decode('utf-8'))\n69:     except Exception as e:\n70:         print(f\"[-] Gagal memuat feed {feed_url}: {e}\", file=sys.stderr)\n71:         return []\n72: \n73:     entries = data.get('feed', {}).get('entry', [])\n74:     posts = []\n75: \n76:     for e in entries:\n77:         title = e.get('title', {}).get('$t', '')\n78:         links = e.get('link', [])\n79:         alt_link = next((l.get('href') for l in links if l.get('rel') == 'alternate'), '')\n80:         \n81:         # Check volume number in title\n82:         m = re.search(r'Volume\\s+([\\d\\.]+)', title, re.I)\n83:         if m:\n84:             vol_str = m.group(1)\n85:             try:\n86:                 vol_num = float(vol_str)\n87:             except ValueError:\n88:                 vol_num = 999.0\n89:             posts.append((vol_num, vol_str, title, alt_link))\n90:         else:\n91:             # Maybe it's a volume without \"Volume\" keyword or side story\n92:             posts.append((999.0, \"Extra\", title, alt_link))\n93: \n94:     posts.sort(key=lambda x: x[0])\n95:     return posts\n96: \n97: def extract_download_links(post_html: str) -> Dict[str, str]:\n98:     \"\"\"Extracts direct download links from volume post HTML.\"\"\"\n99:     found = {}\n100:     matches = re.findall(r'<a\\s+[^>]*href=[\"\\']([^\"\\']+)[\"\\'][^>]*>(.*?)</a>', post_html, re.DOTALL | re.IGNORECASE)"}
