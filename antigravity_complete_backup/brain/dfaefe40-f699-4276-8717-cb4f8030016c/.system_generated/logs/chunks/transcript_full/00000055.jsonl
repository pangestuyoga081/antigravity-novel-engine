o-akashic-records.html\"\r\nhtml = fetch_url(main_url)\r\n\r\n# Print all hrefs in the post body\r\n# Typically blogger post body is in <div class='post-body entry-content' ...>\r\npost_body_m = re.search(r\"<div[^>]*class=['\\\"][^'\\\"]*post-body[^'\\\"]*['\\\"][^>]*>(.*?)<div[^>]*class=['\\\"][^'\\\"]*post-footer\", html, re.DOTALL)\r\nif post_body_m:\r\n    post_body = post_body_m.group(1)\r\nelse:\r\n    post_body = html\r\n\r\nall_a = re.findall(r'<a\\s+[^>]*href=[\"\\']([^\"\\']+)[\"\\'][^>]*>(.*?)</a>', post_body, re.DOTALL | re.IGNORECASE)\r\nprint(f\"Found {len(all_a)} anchor tags:\")\r\nfor href, text in all_a:\r\n    clean_text = re.sub(r'<[^>]+>', '', text).strip()\r\n    if clean_text or 'ruisafe' in href or 'volume' in href:\r\n        print(f\"{clean_text} -> {href}\")\r\n\r\n=== FULL FILE: test_konosuba_links.py ===\r\nimport urllib.request\r\nimport re\r\n\r\ndef check_post(url):\r\n    req = urllib.request.Request(url, headers={'User-Agent': 'Mozilla/5.0'})\r\n    with urllib.request.urlopen(req) as resp:\r\n        html = resp.read().decode('utf-8', errors='ignore')\r\n    print(f\"\\nChecking: {url}\")\r\n    matches = re.findall(r'<a\\s+[^>]*href=[\"\\']([^\"\\']+)[\"\\'][^>]*>(.*?)</a>', html, re.DOTALL | re.IGNORECASE)\r\n    for href, text in matches:\r\n        clean_text = re.sub(r'<[^>]+>', '', text).strip()\r\n        for host in ['mediafire', 'drive.google', 'terabox', 'krakenfiles', 'drop.download', 'mega', 'ruisafe']:\r\n            if host in href.lower() or host in clean_text.lower():\r\n                print(f\"  [{clean_text}] -> {href}\")\r\n\r\ncheck_post(\"https://www.ruidrive.com/2021/10/kono-subarashii-sekai-ni-shukufuku-wo_5.html\")\r\ncheck_post(\"https://www.ruidrive.com/2023/08/pdf-ln-indo-konosuba-17-1.html\")\r\n\r\n"}
